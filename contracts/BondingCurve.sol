    /**
     * getPriceDropInfo --- ------------------------------------------7 ---------------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------------------------------------------------------------------------------------------
     * ------------
     *   - _isPriceDropActive------------------------------------
     *   - _currentDiscountBps---------------------------------
     *   - _priceDropPrice---------------effectivePrice -- (1 - discountBps)---
     *   - _timeUntilNextTier------------------------------------
     *   - _windowTimeRemaining------------------------------------------------------------ 0---
     *   - _currentTierIndex------------------1-5---0 ---------------
     *   - _nextTierDiscountBps------------------------------------
     * ------------
     *   1. ---------------------priceDropWindowEnd > 0 ------------------------------------------------------------
     *   2. --------------------------------------- effectiveLastBuyTimestamp --------- priceDropWindowEnd
     *   3. ------ elapsed------ _getCurrentPriceDropDiscount ---------------
     *   4. --- discountBps == 0---------------------------timeUntil = _getTier1Interval() - elapsed
     *   5. ------------ flashPrice------ tierIndex ------------------------------------------
     */
    function getPriceDropInfo() external view returns (
        bool _isPriceDropActive,
        uint256 _currentDiscountBps,
        uint256 _priceDropPrice,
        uint256 _timeUntilNextTier,
        uint256 _windowTimeRemaining,
        uint256 _currentTierIndex,
        uint256 _nextTierDiscountBps
    ) {
        uint256 effectiveLastBuyTimestamp = lastBuyTimestamp; // ---------------------------------------------

        // ---------------------------------------------------------------
        // If window is active
        if (priceDropWindowEnd > 0 && block.timestamp < priceDropWindowEnd) {
            // --------------------------------- window ------------------------------------------------L2649/L2657---
            // --------------------- solc "declaration shadows an existing declaration" ------------
            // ------------------------------------------------------------------------------------------
            uint256 windowDiscountBps = priceDropWindowDiscountBps;
            // --------------------------------- 5 ------ if ------A4 ------------------------------------
            // ------------ bps ------------ 5 --------- {5000,6000,7000,8000,9000}--------- 1000---------
            // --------------- discountBps ------ _getCurrentPriceDropDiscount --------------- --- ---------
            // ------------------ end --- bps ---------------"end>0 ------------ --- bps---------------"------------------
            // --- tierIndex = (bps --- 4000) -- 1000 --- {1..5}--------- if ---------------
            uint256 windowTierIndex = (windowDiscountBps - 4000) / 1000; // 5000..9000 --- 1..5

            uint256 windowFlashPrice = _getEffectivePrice() * (BPS - windowDiscountBps) / BPS; // ---------
            return (true, windowDiscountBps, windowFlashPrice, 0, priceDropWindowEnd - block.timestamp, windowTierIndex, 0);
        }

        // ---------------------------------------------------------------------------
        // If window has expired (state not yet cleaned up)
        if (priceDropWindowEnd > 0 && block.timestamp >= priceDropWindowEnd) {
            effectiveLastBuyTimestamp = priceDropWindowEnd;
        }

        uint256 elapsed = block.timestamp - effectiveLastBuyTimestamp; // ---------------------
        (uint256 discountBps, uint256 tierIndex) = _getCurrentPriceDropDiscount(elapsed); // ------------------

        if (discountBps == 0) { // ------------------
            // No tier active yet
            uint256 timeUntil = _getTier1Interval() - elapsed; // ------ 1 ---------------
            return (false, 0, 0, timeUntil, 0, 0, PRICE_DROP_TIER1_DISCOUNT_BPS); // --------------- 1 ---
        }

        uint256 flashPrice = _getEffectivePrice() * (BPS - discountBps) / BPS; // ---------

        // ------------------------------B4 ------------------------ bps --------- 1000 --- {5000..9000}---
        // tierIndex---{1..5} --- --------- bps = 4000 + (tierIndex+1)--1000---tier1---6000 --- tier4---9000------
        // --- 5 --------------------- 0--------- 4 ------------------
        uint256 nextDiscountBps = tierIndex == 5 ? 0 : 4000 + (tierIndex + 1) * 1000;

        // ------------------------------------------------ {1/4/8/12/24 ------}---------------------------------
        uint256 timeUntilNext;
        if (tierIndex == 1) { // --- 1 --- --- --- 2 ---
            timeUntilNext = PRICE_DROP_TIER2_INTERVAL - elapsed;
        } else if (tierIndex == 2) { // --- 2 --- --- --- 3 ---
            timeUntilNext = PRICE_DROP_TIER3_INTERVAL - elapsed;
        } else if (tierIndex == 3) { // --- 3 --- --- --- 4 ---
            timeUntilNext = PRICE_DROP_TIER4_INTERVAL - elapsed;
        } else if (tierIndex == 4) { // --- 4 --- --- --- 5 ---
            timeUntilNext = PRICE_DROP_TIER5_INTERVAL - elapsed;
        } // --- 5 ------timeUntilNext ------ 0---------------

        return (true, discountBps, flashPrice, timeUntilNext, 0, tierIndex, nextDiscountBps);
    }

    /**
     * claimRewards --- ---------------------------4 --- rewardType ---------
     * ----------------------------------------------------------------------------
     * --------------- rewardType ------------------------------AIP ------ / Owner AIP / USDT ------ / Owner USDT---
     * ------------rewardType=0/1/2/3
     * ---rewardType=0------------------ AIP ---------referrerRewards[msg.sender]---
     *   - ------------------------------ 0 --- ZeroAmount
     *   - --------- referrerLastRewardTime + REFERRAL_REWARD_EXPIRY---365 ------------------------ _addConsumedToPool ---------------------
     *     ------ ReferralRewardsExpired--------------------------------------------------- operator ---
     *     sweepExpiredReferralRewards ---------------------------------------------------------------------
     *   - --------------- referrerRewards--------- totalPendingReferralRewards------ AIP ------------------ ReferralRewardsClaimed
     * ---rewardType=1---owner --------------- AIP ---------------ownerReferralRewards---
     *   - --- owner---OwnableUnauthorizedAccount ---------
     *   - --------- 0 --- ZeroAmount--------------------- AIP--------- OwnerReferralRewardsClaimed
     * ---rewardType=2---------------USDT --------------------- unlockApp ------------------------------
     *   ---push ------------ _chargeAppUnlockUsdt------------------------------------------------ --- InvalidRewardType
     * ---rewardType=3---owner --------------- USDT ------------ownerUsdtFees---
     *   - --- owner---OwnableUnauthorizedAccount ---------
     *   - --------- 0 --- ZeroAmount--------------------- USDT--------- OwnerUsdtFeesClaimed
     * --------- rewardType---InvalidRewardType
     */
    function claimRewards(uint8 rewardType) external {
        if (rewardType == 0) {
            // --------------- AIP ------
            // claimReferralRewards
            uint256 reward = referrerRewards[msg.sender];
            if (reward == 0) revert ZeroAmount(); // ---------------

            // 365 ------------------------------------------------------------------
            if (block.timestamp > referrerLastRewardTime[msg.sender] + REFERRAL_REWARD_EXPIRY) {
                referrerRewards[msg.sender] = 0;
                totalPendingReferralRewards -= reward;
                _addConsumedToPool(reward); // ------------------

                emit ReferralRewardsExpired(msg.sender, reward);
                return;
            }

            referrerRewards[msg.sender] = 0;
            totalPendingReferralRewards -= reward;
            token.safeTransfer(msg.sender, reward); // --- AIP ---------

            emit ReferralRewardsClaimed(msg.sender, reward);
        } else if (rewardType == 1) {
            // owner --------------- AIP ------------
            // claimOwnerReferralRewards
            if (msg.sender != owner()) revert OwnableUnauthorizedAccount(msg.sender); // --- owner
            uint256 reward = ownerReferralRewards;
            if (reward == 0) revert ZeroAmount(); // ---------------

            ownerReferralRewards = 0;
            token.safeTransfer(msg.sender, reward); // --- AIP --- owner

            emit OwnerReferralRewardsClaimed(msg.sender, reward);
        } else if (rewardType == 3) {
            // owner --------------- USDT ---------
            // claimOwnerUsdtFees
            // ---rewardType=2 ------------USDT ------------------ unlockApp ------------------------------ _chargeAppUnlockUsdt---
            if (msg.sender != owner()) revert OwnableUnauthorizedAccount(msg.sender); // --- owner
            uint256 amount = ownerUsdtFees;
            if (amount == 0) revert ZeroAmount(); // ------------------

            ownerUsdtFees = 0;
            usdt.safeTransfer(msg.sender, amount); // --- USDT --- owner

            emit OwnerUsdtFeesClaimed(msg.sender, amount);
        } else {
            revert InvalidRewardType(); // ------------
        }
    }

    /**
     * sweepExpiredReferralRewards --- operator ------------------------------ AIP ------------------------------
     * ----------------------------------------------------------------------------
     * --------------------------------------------------------------------------- 365 --------------------- AIP ---------------
     *        ------ _addConsumedToPool ---------------------operator ------------------------ custodian ---------
     * ------------------------------------------------------------ claimRewards(0) ------------------------------
     *        ------------------------------------------/------------------------------------------------------------------
     *        --------------------- --- --------------------------------- operator ------------------------"------------
     *        ------------------"------------------------------------------------------------------
     * ------------operator --- owner --------------- consume ---------------owner ------------------------------------
     *        --------- setOperator ---------operator ------------------------------------------------------ --- NotOperator
     * ------------
     *   - referrerRewards[account] == 0 --- ZeroAmount------------------------
     *   - ------------block.timestamp <= referrerLastRewardTime[account] + 365 ---------
     *     ReferralRewardsNotExpired------------------------------------------------------------
     *     365 ------------------ operator ------------------------------------------"------------------------------"---
     *     ------------------ confiscation
     * ---------------referrerRewards[account] = 0---totalPendingReferralRewards ---------
     *        --------------- AIP ---------operator ------------ custodian ---------_addConsumedToPool------
     *        ------ ReferralRewardsExpired------------------------------------------------------------
     *        ---------------"------------"---------------
     * ------ claimRewards(0) ------------------------------------------------------------------------ --- ------------ ---
     *        ------------------------------------------------------------------------ ZeroAmount---------------------
     *        ------------------------------------------------------------------------ AIP ------------------
     */
    function sweepExpiredReferralRewards(address account) external {
        if (msg.sender != operator && msg.sender != owner()) revert NotOperator(); // operator --- owner ---------
        _sweepExpiredReferralRewards(account);
    }

    /**
     * sweepExpiredReferralRewardsBatch --- ------------------------------ AIP ---------------------------------
     * ----------------------------------------------------------------------------
     * ---------------**------------**--------------------------- sweepExpiredReferralRewards ---------------
     *        --------------- --- ------------ --- _addConsumedToPool ------------------ (N-1) ------------
     *        --------------------- ~21k gas------------------------
     * ------------accounts=------------------------operator ---------------------------------------------------
     * ------------operator --- owner ------------------------ --- NotOperator---
     * ------------
     *   - --------- --- ZeroAmount---------------------
     *   - --------------------------------------- 0 ------------------ **------------**---ZeroAmount /
     *     ReferralRewardsNotExpired------------------------------------------------------------------
     *     ------------------------------------------ referrerRewards --- referrerLastRewardTime---
     * ---gas ------------------------ _addConsumedToPool ------------------------------------ gas------
     *        ------------------ --- 100 ------------------------------------ gas ------------------------------------------
     *        N ------------------------------ N --------------------- EVM ------------------------------
     * --------------------------------------- _sweepExpiredReferralRewards------------------------------
     */
    function sweepExpiredReferralRewardsBatch(address[] calldata accounts) external {
        if (msg.sender != operator && msg.sender != owner()) revert NotOperator(); // operator --- owner ---------
        uint256 len = accounts.length;
        if (len == 0) revert ZeroAmount(); // ---------------------------
        for (uint256 i = 0; i < len; i++) {
            _sweepExpiredReferralRewards(accounts[i]);
        }
    }

    /**
     * _sweepExpiredReferralRewards --- ------------------------------------------/------------------
     * ----------------------------------------------------------------------------
     * ------------caller --------- operator ------------
     * --------------------- 0 --- ZeroAmount------------ --- ReferralRewardsNotExpired
     *          ---365 ------------------ operator ------------------------------------------"------------------
     *          ------------"--------------------- confiscation---
     * ------------referrerRewards[account] = 0---totalPendingReferralRewards ---------
     *        _addConsumedToPool ---------operator ------------ custodian ------------
     *        ------ ReferralRewardsExpired
     */
    function _sweepExpiredReferralRewards(address account) internal {
        uint256 reward = referrerRewards[account];
        if (reward == 0) revert ZeroAmount(); // ------------------
        if (block.timestamp <= referrerLastRewardTime[account] + REFERRAL_REWARD_EXPIRY) {
            revert ReferralRewardsNotExpired(); // ---------------------------------------------------
        }
        referrerRewards[account] = 0;
        totalPendingReferralRewards -= reward;
        _addConsumedToPool(reward); // ---------------------operator ---------------------

        emit ReferralRewardsExpired(account, reward);
    }

