    /**
     * getReferralBps --- --------------------------------------------------- USDT ---------------6 ------------
     * ----------------------------------------------------------------------------
     * --------------- referrerInviteeCount[referrer] ------------------------ BPS ------
     * ------------------------------------------------------------------
     *   - ---------< 5 ---------APP_UNLOCK_REFERRAL_BPS---5%---
     *   - --- 5 ------TIER1------7%
     *   - --- 10 ------TIER2------10%
     *   - --- 20 ------TIER3------20%
     *   - --- 100 ------TIER4------40%
     *   - --- 500 ------TIER5------60%
     *   - --- 1000 ------TIER6------80%
     * ------------bps ------------------------1 BPS = 0.01%---
     */
    function getReferralBps(address referrer) internal view returns (uint256) {
        uint256 count = referrerInviteeCount[referrer]; // ------------------
        uint256 bps = APP_UNLOCK_REFERRAL_BPS; // ------ 5%
        if (count >= REFERRAL_TIER1_THRESHOLD) { // --- 5 ---
            bps = REFERRAL_TIER1_BPS; // 7%
        }
        if (count >= REFERRAL_TIER2_THRESHOLD) { // --- 10 ---
            bps = REFERRAL_TIER2_BPS; // 10%
        }
        if (count >= REFERRAL_TIER3_THRESHOLD) { // --- 20 ---
            bps = REFERRAL_TIER3_BPS; // 20%
        }
        if (count >= REFERRAL_TIER4_THRESHOLD) { // --- 100 ---
            bps = REFERRAL_TIER4_BPS; // 40%
        }
        if (count >= REFERRAL_TIER5_THRESHOLD) { // --- 500 ---
            bps = REFERRAL_TIER5_BPS; // 60%
        }
        if (count >= REFERRAL_TIER6_THRESHOLD) { // --- 1000 ---
            bps = REFERRAL_TIER6_BPS; // 80%
        }
        return bps;
    }

