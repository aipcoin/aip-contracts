        if (_usdt == address(0)) revert InvalidAddress(); // ------ USDT --------- 0
        usdt = IERC20(_usdt); // ------ USDT ---------immutable---------------------
        initialSaleRemaining = TOTAL_SHARES * TOKENS_PER_SHARE; // ------------------ = 1000 -- 10000 = 10,000,000 AIP
        operator = msg.sender; // operator --------------------------------- owner ------
        holdThreshold = 50e18; // ------------------ 50 AIP
        lastBuyTimestamp = block.timestamp; // ------------------
        currentPeriodStart = _monthStartUTC(block.timestamp); // ------------------ = ------------ UTC --- 1 --- 0 ---------------------------------
        STAKING_MONTH_ANCHOR = currentPeriodStart; // --------------- = ------------------ periodIndex = 0---
        // ------------------------ = "--------------- + 3 ---" --------------------------------- UTC 0 ------
        //   1. raw      = block.timestamp + 3 days---259,200 ---------------------------------------------------
        //   2. dayStart = raw --------------------- UTC ------ 0 ------Unix ------------ 86400 ---------------------
        //      ---------------------Unix ------------------------ UTC ------------------------------
        //   3. raw == dayStart--------------- UTC 0 ------------ --- raw ------------------------ 3 ---------
        //      --------- dayStart + 1 --------------- 0 ------------------ 3~4 --------------------------- 4 ---------
        //   ------------------------ 00:00:00 UTC--------------------------------------------------------------------- 3 ---------
        //   - block.timestamp ------------------------------------------------------------------------------------ setter------
        //     ---------------------------------------------------------
        //   - ------------ INITIAL_SALE_END_TIME---2028-01-04 UTC---------------------------------
        //     ---------------------------------------------------------------------------------------------
        uint256 rawStart = block.timestamp + 3 days; // ------ + 3 ---------------------------------
        uint256 startDayBegin = rawStart - (rawStart % 1 days); // rawStart ------ UTC ------ 0 ---
        INITIAL_SALE_START_TIME = (rawStart == startDayBegin)
            ? startDayBegin // ------------ 0 ---------+3 ------------ 0 --------------- 3 ------
            : startDayBegin + 1 days; // ------------------ UTC 0 --------------- 3~4 ---------
    }

