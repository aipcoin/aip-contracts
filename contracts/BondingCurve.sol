    /**
     * buyInitialShare --- ------------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------- 200 USDT ------ 1 ------------------ 10000 AIP------------------ 1 ---
     * ------------------------------ approve USDT ------------
     * ------------referrer--------------------------- 0 ------------------------------
     * --------------------- revert------------------------------------------
     * ---------------200 USDT --------- owner------------------------------------------------
     *           ------------------------------------------------------ 10000 AIP ------------sharesSold+1
     * ------------InitialBought
     */
    function buyInitialShare(address referrer) external {
        _checkNotPaused(); // ---------------------------------------------------------------------------------------------------------
        if (block.timestamp < INITIAL_SALE_START_TIME) revert InitialSaleNotStarted(); // ------------------------------ 3~4 --------------------- UTC 0------------
        if (block.timestamp >= INITIAL_SALE_END_TIME) revert InitialSaleEnded(); // ------------------
        if (hasBoughtInitialShare[msg.sender]) revert AlreadyBoughtInitialShare(); // --------------- 1 ---
        if (sharesSold >= TOTAL_SHARES) revert InitialSaleSoldOut(); // 1000 ---------

        uint256 usdtCost = SHARE_PRICE; // 200 USDT
        uint256 aipAmount = TOKENS_PER_SHARE; // 10000 AIP

        _bindReferrer(msg.sender, referrer, referrerOf[msg.sender] == address(0)); // ------------------------------------------------------------------------------------------ revert ---------
        hasBoughtInitialShare[msg.sender] = true; // ---------------
        initialShareBuyTime[msg.sender] = block.timestamp; // ---------------------Floor Plan ------
        initialShareAipAmount[msg.sender] = aipAmount; // ------------ AIP ---------Floor Plan ------

        address boundReferrer = referrerOf[msg.sender]; // ---------------------------------------_getActiveReferrer --- isActive ---------------------------------------------------------------------------

        // --------------------------- owner------------------------------------------------------
        usdt.safeTransferFrom(msg.sender, owner(), usdtCost);

        emit InitialBought(msg.sender, usdtCost, aipAmount, boundReferrer);

        token.safeTransfer(msg.sender, aipAmount); // ------ 10000 AIP ---------

        sharesSold += 1; // ------------ +1
        initialSaleRemaining -= aipAmount; // ------ AIP ------
    }

