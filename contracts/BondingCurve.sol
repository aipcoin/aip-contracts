    /**
     * initialShareProfile --- --------------------------------------------------- view------------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------hasBoughtInitialShare / initialShareBuyTime /
     *   initialShareAipAmount ------ mapping--------------- 50 / 85 / 86--------- private------ getter
     *   ------------------------------------------------FloorPlanSub --------------------------------------- mapping---
     *   --------------------------------------------------------------- 3 ------------------
     * ------------user=------------
     * ------------
     *   - _bought---hasBoughtInitialShare[user]--------------------------------------------- buyInitialShare---
     *   - _buyTime---initialShareBuyTime[user]--------------------------------- 0---
     *   - _aipAmount---initialShareAipAmount[user]--------------------- AIP ---------= TOKENS_PER_SHARE = 10000 AIP---
     * ---------------FloorPlanSub ------------lock/claim ---------------getFloorPlanFullInfo------------
     */
    function initialShareProfile(address user) external view returns (bool _bought, uint256 _buyTime, uint256 _aipAmount) {
        return (hasBoughtInitialShare[user], initialShareBuyTime[user], initialShareAipAmount[user]);
    }

    /**
     * hasUnlockedAnyApp --- ------------------------------------------------------------ view------------------
     * ----------------------------------------------------------------------------
     * ------------------ appList ------------ appAccess[user][appId]------------ true --------- true
     *   ------------------------------------------------------------ staking/weeklyRanking/referral ---------
     *   ---------------------------/------------------
     * ------------user=------------
     * ------------bool------------------------------------------
     * ---------------FloorPlanSub ------------lock/claim ---------------getFloorPlanFullInfo------------
     * ------------------------ internal ------ _hasUnlockedFloorPlanApp ---------------------------------
     *   --------------------- lockFloorPlan/claimFloorPlan ------------------ FloorPlanSub------
     *   ---------------------------------------------------------------------
     */
    function hasUnlockedAnyApp(address user) external view returns (bool) {
        uint256 len = appList.length;
        for (uint256 i = 0; i < len; i++) {
            if (appAccess[user][appList[i]]) {
                return true;
            }
        }
        return false;
    }

