     *   AlreadyInitialized/setToken ---"---------------------"------------------------------------ setter---
     *   ------------------------------------------------------------
     * ------------------------
     *   - _weeklySub != address(0) --- _finaleSub != address(0)---InvalidAddress---------------------
     *   - weeklySub == address(0) && finaleSub == address(0)---PoolSubAlreadySet---------------------
     *     ---------------------------------------------------------------------------------
     * ------------------------------ setStakingPoolAllocation()--------------------- 0--------------------- 0---
     *   --------------------- 0.5M ---------------------------------------------------------------------
     * --------------------------------------------------------------- weeklySub/finaleSub ------------------
     *   ---migrate ------------------------------------------------------------depositToPool(poolType=1/2)
     *   ------ revert PoolMigratedToSub---------------------------------
     * ------------PoolsMigratedToSubs(weeklySub, finaleSub, weeklyPool ---------, finalePool ---------)
     */
    function migratePoolsToSubs(address _weeklySub, address _finaleSub) external onlyOwner {
        // ===== --- 1 --------------------------- =====
        if (_weeklySub == address(0)) revert InvalidAddress(); // ------------------------ 0---------------------
        if (_finaleSub == address(0)) revert InvalidAddress(); // ------------------------ 0---------------------
        if (weeklySub != address(0) || finaleSub != address(0)) revert PoolSubAlreadySet(); // ---------------------------------

        // ===== --- 2 ------------------------------------ 93/94---------------------=====
        // ---------------------------------------------------------depositToPool ------/---------------------------
        // ---------------/------ revert---------------------------------------------------------------------------------
        weeklySub = _weeklySub;
        finaleSub = _finaleSub;

        // ===== --- 3 ------------------------------------ + ------------------------------ _fundSubPool---=====
        uint256 weeklyAmount = weeklyPool; // ---------------------------setStakingPoolAllocation ------------ 500,000 AIP + ---------------------------------
        _fundSubPool(_weeklySub, weeklyAmount); // AIP ------ + ---------------------------------
        weeklyPool = 0; // --------------------------------------- 0---withdrawTokens ---------------------

        // ===== --- 4 ------------------------------------------------------------ _fundSubPool---=====
        uint256 finaleAmount = finalePool; // ------------------------------------500,000 AIP + ---------------------
        _fundSubPool(_finaleSub, finaleAmount); // AIP ------ + ---------------------------------
        finalePool = 0; // --------------------------------------- 0---

        // ===== --- 5 ------------------------------------------------------------------------------------------=====
        emit PoolsMigratedToSubs(_weeklySub, _finaleSub, weeklyAmount, finaleAmount);
    }

