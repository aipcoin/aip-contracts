    /**
     * hasAppAccessById --- --------------------------------------------------------------- view------------------
     * ----------------------------------------------------------------------------
     * ------------internal ------ hasAppAccess ---------------------P2 ------------------------/---------------------
     *   ------------"------------------------------weeklyRanking / finalePool------------------"------------------
     *   --------------- + ------------------------------------------------------------------------------------------------
     * ------------user=---------------_appId=------ ID---keccak256 ------------ keccak256("weeklyRanking")---
     * ------------bool--------------------------------------------------------- + --------------- + ---------------
     * ---------------WeeklyRankingSub---------/------------------------FinalePoolSub---------------------------------
     * ------------------------ internal hasAppAccess ------------------------------ hasUnlockedAnyApp ------------
     */
    function hasAppAccessById(address user, bytes32 _appId) external view returns (bool) {
        return hasAppAccess(user, _appId); // --------------------------------- + ------------ + ------------------------
