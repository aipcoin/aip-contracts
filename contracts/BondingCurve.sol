    /**
     * _getCurrentPrice --- ------------------------------------------------------------
     * ----------------------------------------------------------------------------
     * ---------------------------------------------------------------
     * ------------P = BASE_PRICE + PRICE_COEFFICIENT -- (volume/VOLUME_REFERENCE)^exponent
     *         --- P = 0.1 + 0.9 -- (V--3,000,000)^----------[1.22, 1.38]
     * ------------------volume > 100M USDT --------------- 10M USDT ------ -0.01--------- 1.22
     * ---------------------1e18 ------------ 1e17=0.1 USDT---
     */
    function _getCurrentPrice() internal view returns (uint256) {
        uint256 volume = totalUsdtVolume;
        if (volume == 0) return BASE_PRICE; // --------------------------- 0.1 USDT

        uint256 base = volume * PRECISION / VOLUME_REFERENCE; // ---------------------V--3M---1e18 ---------

        int256 exponent = int256(EXPONENT_INITIAL); // ------------ 1.38
        if (volume > EXPONENT_DECAY_THRESHOLD) { // ------ 100M USDT ------------
            uint256 decaySteps = (volume - EXPONENT_DECAY_THRESHOLD) / EXPONENT_DECAY_STEP; // ------------
            int256 decayed = int256(EXPONENT_INITIAL) - int256(EXPONENT_DECAY_RATE) * int256(decaySteps); // ---------------
            if (decayed < int256(EXPONENT_FLOOR)) { // --------------- 1.22
                decayed = int256(EXPONENT_FLOOR);
            }
            exponent = decayed;
        }

        uint256 powResult = ExponentialMath.pow(base, exponent); // base^exponent---1e18 ---------
        return BASE_PRICE + PRICE_COEFFICIENT * powResult / PRECISION; // 0.1 + 0.9 -- powResult
    }

    /**
     * getPriceInfo --- ------------------------------10 ---------------
     * ----------------------------------------------------------------------------
     * ---------------------------------------------
     *        ------------------ _getSimulatedFloorPrice() ------------------------------------------
     *        ------------------------------------------ _processYearBoundaries() ------------------------
     * ------------------------view---
     * ------------currentPrice/totalShares/tokensInPool/usdtPerShare/poolEpoch/totalUsdtVolume/
     *        lastBuyTimestamp/sharesSold/sharesRemaining/tokensPerShare
     */
    function getPriceInfo() external view returns (
        uint256 _currentPrice,
        uint256 _totalShares,
        uint256 _tokensInPool,
        uint256 _usdtPerShare,
        uint256 _poolEpoch,
        uint256 _totalUsdtVolume,
        uint256 _lastBuyTimestamp,
        uint256 _sharesSold,
        uint256 _sharesRemaining,
        uint256 _tokensPerShare
    ) {
        uint256 naturalPrice = _getCurrentPrice();
        uint256 simulatedFloor = _getSimulatedFloorPrice();
        uint256 displayPrice = naturalPrice >= simulatedFloor ? naturalPrice : simulatedFloor; // ------------------------------------------------
        // U5 ------------------------------------------------_getEffectivePrice---------------------------
        // "--------------- == ---------------"---------------------------------------------
        if (displayPrice > PRICE_ABS_CAP) displayPrice = PRICE_ABS_CAP;
        return (
            displayPrice,
            mainPool.totalShares,
            mainPool.tokensInPool,
            mainPool.usdtPerShare,
            mainPool.epoch,
            totalUsdtVolume,
            lastBuyTimestamp,
            sharesSold,
            TOTAL_SHARES - sharesSold, // ---------------
            TOKENS_PER_SHARE
        );
    }

    /**
     * getSimulatedFloorPrice --- ------------------------------------------------ view---
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------------------------------------------
     * ------------------------------------------ currentFloorPrice---yearStartTime==0 --------- 0
     */
    function getSimulatedFloorPrice() external view returns (uint256) {
        uint256 simFloor = _getSimulatedFloorPrice();
        // U5 ------------------------ _getEffectivePrice ---------------------------------------------------------
        // --- ---------------------------------------------------"------------------------------------"------------------------
        // ------------------------------------------------------
        return simFloor <= PRICE_ABS_CAP ? simFloor : PRICE_ABS_CAP;
    }

    /**
     * _getEffectivePrice --- ------------------------------------------------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------------------------- = min(max(---------, ------------------ currentFloorPrice), PRICE_ABS_CAP)
     * ------------currentFloorPrice=0 ------------------------>0 ---------------------------------------
     * ---U5 ------------------------------------------------ pow ------------------------------------------------------
     *   ------------------------------------ --- ---------------------------------------------------------"------------
     *   ------------------"------------------------------------------------------------------------
     *   PRICE_ABS_CAP(1e9 USDT/AIP) ---------------------------------------------------------------
     *   ---------------------------------------------buyFromPool---------------------------------U1---------
     *   ------------------------------------------------------
     */
    function _getEffectivePrice() internal view returns (uint256) {
        uint256 naturalPrice = _getCurrentPrice();
        uint256 effective = naturalPrice >= currentFloorPrice ? naturalPrice : currentFloorPrice; // ------------
        return effective <= PRICE_ABS_CAP ? effective : PRICE_ABS_CAP; // ------------------------------------------
    }

    /**
     * _annualFloorVerdict --- ---------------------------------------B4 ---------_processYearBoundaries ---
     * _getSimulatedFloorPrice --------------------------- --- ------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------------"------ +25% ------"------------------
     *   - --------------- < --------------------------- -- 1.25------ --------------------------- = ------------
     *     --------------- = ------------------------------------
     *   - --------------- --- --------------- --- ------------------------------------------------ = 0------
     *     --------------- = ---------------------------------------------------
     * ------------------------------------------------ 1.25^n --------------------------------------- +25%------
     *   --- _processYearBoundaries ---------------------------
     * ------------newFloor=------------ currentFloorPrice---newYearStartEff=------------ yearStartEffectivePrice
     */
    function _annualFloorVerdict(uint256 yearStartEff, uint256 effectivePrice)
        private pure returns (uint256 newFloor, uint256 newYearStartEff)
    {
        uint256 requiredPrice = yearStartEff * (BPS + ANNUAL_FLOOR_BPS) / BPS; // ------------------------------ +25%---
        if (effectivePrice < requiredPrice) { // ------------------------------------
            newFloor = requiredPrice;
            newYearStartEff = requiredPrice;
        } else { // ------------------------------------
            newFloor = 0;
            newYearStartEff = effectivePrice;
        }
    }

    /**
     * _getSimulatedFloorPrice --- ---------------------------------------
     * ----------------------------------------------------------------------------
     * --------------------------------------------------- _processYearBoundaries() ---------------------
     *         currentFloorPrice ------------------ getPriceInfo --- view ---------------
     *         ------------------------------------------------------
     * ------------1. yearStartTime == 0 --- ------ 0------------------------------
     *         2. yearsElapsed == 0 --- ------------ currentFloorPrice---------------
     *         3. ------ --- --- _processYearBoundaries ------------------ _annualFloorVerdict---B4 ---------
     *            ------"------------"---"------------"------------------------ _getEffectivePrice()---------
     *            max(naturalPrice, currentFloorPrice) ---------------currentFloorPrice ------
     *            simFloor --------------------------------------------------- PRICE_ABS_CAP---U5 ---------
     *            --------- = --------------------------- getSimulatedFloorPrice / getPriceInfo ------
     *            ------------------------------------------
     */
    function _getSimulatedFloorPrice() internal view returns (uint256) {
        if (yearStartTime == 0) return 0; // ------------------------

        uint256 yearsElapsed = (block.timestamp - yearStartTime) / YEAR_DURATION;
        if (yearsElapsed == 0) return currentFloorPrice; // ------------------------------

        // --------------------------------------------------------- +25%------------------ _processYearBoundaries ---------
        (uint256 simFloor, ) = _annualFloorVerdict(yearStartEffectivePrice, _getEffectivePrice());
        return simFloor;
    }

    // ------------ _getAnnualIncreaseBps --------------- B4 ------------------------------------------ 25%---
    //       --------------------------- ANNUAL_FLOOR_BPS------------------------ _annualFloorVerdict------

    /**
     * _processYearBoundaries --- ------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------------------- currentFloorPrice --- yearStartEffectivePrice
     * ------------------------------------------------------------------1 ------3 ------5 ------------
     *         ------"---------------"------------ +25%---ANNUAL_FLOOR_BPS------------------
     *         --------------- _getSimulatedFloorPrice ------ _annualFloorVerdict---B4 ------------
     *   - ------------------ < --------------- --- ------------------------ = ------------------------ = ------------
     *   - ------------------ --- --------------- --- ------------------------ = 0--------------- = ------------------
     * --------------------------------------------------------- 1.25^n ---------------------------------
     *         --------------- +25% --------------------------------- yearStartTime ---------------------
     * ------------buyFromPool ---------
     */
    function _processYearBoundaries() internal {
        if (yearStartTime == 0) return; // ------------------------

        uint256 yearsElapsed = (block.timestamp - yearStartTime) / YEAR_DURATION; // ------------
        if (yearsElapsed == 0) return; // ---------

        // --------------------------------------------------- +25% --------------------- B4 ---------
        (uint256 newFloor, uint256 newYse) = _annualFloorVerdict(yearStartEffectivePrice, _getEffectivePrice());
        currentFloorPrice = newFloor;
        yearStartEffectivePrice = newYse;

        yearStartTime += yearsElapsed * YEAR_DURATION; // ---------------------------------
    }

