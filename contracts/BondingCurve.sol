    /**
     * _advanceEpochIfDust --- ------------/---------------------------Phase-2 ------------------
     * _advanceEpochIfDrained --- backup --- _advanceBackupEpochIfDust + _sellBackupTokens
     * ------------------------------ --- ------------------------------ storage ------------------
     * ----------------------------------------------------------------------------
     * --------------- p.tokensInPool --- POOL_DUST_THRESHOLD --- p.totalShares > 0 ------
     *   --------------------- perShare --- epoch+1 --- totalShares ------------------------------------
     *   ------------------------ USDT ---------------
     * --------------------------- POOL_DUST_THRESHOLD---1e-6 AIP---------------------------------------
     *   10 USDT ------------------------------"---------"---------"--------- 1 wei ---------------"---
     *   --------------------------- POOL_DUST_THRESHOLD ---------------------------
     * ---------------------------------------------------------------------------------------------------------
     *   p.usdtPerShare ------------------------------------------------------------------------------
     *   perShare------------------------------------ USDT ---------------------------------------------
     * ---------------------------------------------num=0, den=1--------------------------------------- mapping
     *   ------ (0,0) --------------------------------------------- Phase-2 ------------------ 2--SSTORE
     *   ------------------ 4 --- gas------
     * ------------emitEvent=true ------ PoolEpochAdvanced------------------------------backup ---
     *   ------------------------------ backup ------------ false---------------------------
     * ---_sellBackupTokens ------------------------ backup ------------------------------------------
     *   ---==0--------------------------------- --- ------------------------------"--------------- ---1e12 wei"
     *   ------------------------------------------------------------------------------------~1e-7 USDT------
     *   --------------------------------------- stake ------------------------------------------------------------
     * ------------------backup ------------------ perShare ------------------ totalShares > 0
     *   ------------------------------------------------------ M1b ------------------------------------------------
     */
    function _advanceEpochIfDust(SharePool storage p, bool emitEvent) internal {
        if (p.tokensInPool <= POOL_DUST_THRESHOLD && p.totalShares > 0) { // ---------------------------------
            p.epochEndPerShare[p.epoch] = p.usdtPerShare; // ------------------------------ USDT---------------------------
            uint256 oldEpoch = p.epoch;
            p.epoch += 1; // ---------------------------------------------------------------------
            p.totalShares = 0; // --------------------------------------- epoch ---------------
            if (emitEvent) {
                emit PoolEpochAdvanced(oldEpoch, p.epoch); // ------------------------------------------------------
            }
        }
    }

    /**
     * _accumulateUsdt --- --------- USDT --------------------------------Phase-2 ------------------
     * _accumulateUsdtPerShare --- backup --- _sellBackupTokens --------------------- --- ---------------
     * ----------------------------------------------------------------------------
     * --------------------------------- USDT ------------ p.usdtPerShare------------------
     *        p.usdtPerShare += usdtNet -- PRECISION / p.totalShares
     * --------------------------- totalShares --------------------- / --------------------------------- 0---
     *          ------------------------------------------------------------------------------------------------
     * ------------p.remainder += usdtNet -- PRECISION---------------------
     *        inc = p.remainder / p.totalShares------------------------------------
     *        p.remainder -= inc -- p.totalShares---------------------------
     *        p.usdtPerShare += inc
     * ------------------------ + p.remainder == --------------- -- PRECISION------------------
     * ------------------p.totalShares > 0------------------------------------------------------------------------
     *          backup ------------------------------------------------------------------ totalShares==0
     *          ---------------------------------------------
     */
    function _accumulateUsdt(SharePool storage p, uint256 usdtNet) internal {
        p.remainder += usdtNet * PRECISION; // ---------------------
        uint256 inc = p.remainder / p.totalShares; // ---------------------------------
        p.remainder -= inc * p.totalShares; // ---------------< p.totalShares------------------
        p.usdtPerShare += inc; // --------------- USDT
    }

    /**
     * _accruedUsdt --- ------------------------------ USDT ------------------B2 ------------ withdrawAll /
     * claimUsdt / getCustodianInfo --------------------------- --- ---------------
     * ----------------------------------------------------------------------------
     * ------------pending = shares -- mainPool.usdtPerShare -- PRECISION --- debt---mulDiv ------------
     *        ------------------ panic ------------------------------------------------
     * ---------------------debt ---------------"--------------- usdtPerShare ------------"---------
     *        uPS --------------------- --- ------ shares -- uPS -- P --- debt------------------
     * ------------shares=---------------------------------debt=------------------
     */
    function _accruedUsdt(uint256 shares, uint256 debt) internal view returns (uint256) {
        return Math.mulDiv(shares, mainPool.usdtPerShare, PRECISION) - debt;
    }

    // ======================= ---------------------Phase-2 ---------------/backup ------------------ =======================
    /**
     * _rescale --- ----------------------------------------------- _rescalePool --- _rescaleBackupPool
     * ------------------ --- ------------------------------ storage ------------------
     * ----------------------------------------------------------------------------
     * --------------- p.totalShares --- T_old ------ T_new---T_new < T_old---------------------------------------
     *        ---------------------------------_walkEpochChain--------------------------------------------- O(1)
     *        ------------------------------------------------------------
     *        ------------"------------------"------------------------------U2 ---------------------------------------------
     * ---------------------------------------------------------------------
     *        tNew < p.totalShares------------------------------------------------------------------------------------
     *        p.tokensInPool > 0------------ AIP ---------------"---------------"---------------------------
     *        p.totalShares > 0---------------------------
     * ------------------------------------------ bug---------------------------------------------------------------------
     *   --------------------------------------------------------------------------------------------------- den ------------------
     *   --- ---------p.epochEndPerShare[------------] = p.usdtPerShare
     *      ------------------------ USDT ---------------------"------"---------------------usdtPerShare---
     *      ------------ = ------------------------------------------------------------------
     *      "------ -- --------- --- ---------"------------------------------------------------------------------
     *   --- ------------------p.scaleNumPerEpoch[e] = T_new---p.scaleDenPerEpoch[e] = T_old
     *      --------------------------------------------- = --------- -- num -- den------------------------------
     *   --- ---------------p.epoch += 1---------------------------------------"------------------------"---
     *      "------------------------"---------------------------------------------------------------------------------
     *   --- --------------- T_new---p.totalShares = T_new---
     * ------------------------------------------------------------------------------
     *   -- p.tokensInPool------AIP ------------------------------------I3---------------------I4---------------------
     *   -- p.usdtPerShare------------------------------------------------------------------------------------------------
     *   -- p.remainder---------------------------------------------------------------------------------
     * ------------------------------------------------ s = T_new/T_old---s<1------------------ i ---------------------
     *   --------- S_i' = S_i -- s------------ T' = T_old -- s = T_new--------- S_i'/T' = S_i/T_old ---------------
     *   ------------ net --------------------- = (S_i/T_old) -- (rem + net--P)------"------------"------------------
     *   --- rem---usdtPerShare ---------------------------------------------------------------------------------------------
     *   ------------------------------------------------------------------------------------------"------------ + ---------------
     *   ------------------------"------------------------------------ _walkEpochChain --- USDT ------------------
     * ------------PoolRescaled(fromEpoch, toEpoch, scaleNum, scaleDen, oldT, newT, triggerType)
     *   ------triggerType ---------------1=------------ 2=--------------------- 3=------owner------
     *   11=backup------ 12=backup--------- 13=backup owner
     */
    function _rescale(SharePool storage p, uint256 tNew, uint8 triggerType) internal {
        // ------------------------------tNew < p.totalShares---p.tokensInPool > 0---p.totalShares > 0
        // --------------------------------------- bug------
        p.epochEndPerShare[p.epoch] = p.usdtPerShare; // --- --------------------------- USDT ------------
        p.scaleNumPerEpoch[p.epoch] = tNew; // --- ------------------------ = ------------ T_new------------------------
        p.scaleDenPerEpoch[p.epoch] = p.totalShares; // --- ------------------------ = ------------ T_old------------------------------------
        uint256 oldEpoch = p.epoch;
        uint256 oldT = p.totalShares;
        p.epoch += 1; // --- ---------------------------------------------------------------------------
        p.totalShares = tNew; // --- --------------- tNew---tokensInPool/usdtPerShare/remainder ------------------------------
        emit PoolRescaled(oldEpoch, p.epoch, tNew, oldT, oldT, tNew, triggerType);
    }

    /**
     * _mintPoolShares --- -----------------------------------Phase-2 ------------------ _computeMainPoolShares
     * --- stake() --------- backup --------- --- ------------------------------ storage ------------------
     * ----------------------------------------------------------------------------
     * ---------------------------------------"------/------ amount AIP ------------------"------------------------------
     *        U2 ---------------------newShares > amount -- K------------ _rescale ------------------------
     *        K--R---------------------------------------------------------------------------------------------------------------------
     *        --- view---------------------------------------"------------------1e60 ------/_syncCustodianEpoch/------"------
     *        ---U3.4 ---------------------------------------------
     * ---U2 --------------------------------- + backup ---------------------------------------------------------
     *   -- ---------------p.totalShares==0------------------amount --- amount -- K ------------K --- 1------
     *   -- ------ ------------------------------------------------ T/R > K ---------------------------
     *     newShares = amount -- T -- R ------------ T' = T + amount--T/R = T--(R+amount)/R---
     *     R' = R + amount--------------- T'/R' = T/R ------------------------------------T/R ------------------------
     *     ------------------------------------"T/R ------ > K"------------------------------------------------------------
     *     ---A ---------------------------------------B ------------------------------------------------T/R --- 1---------
     *     K=1e12 --- 12 ------------------------------------
     *   -- ------ ------------------------------------------------------------------------------------ newShares = anchorCap---
     *     --------------------------------- AIP ------ amount/(R+amount) ------------------------
     *     amount--K/(T + amount--K)------------------------------------------------------------------------------------ I3------
     *     --------- _rescale ------------------------ K--R------------------------------------------------------------------
     *     ------------------------------------------------------------------------------------------------
     *   -- ------ ------------------------I2------------------ T := K--R---R ------------------ amount------------------
     *     newShares = amount--K---R' = R + amount------ T' = K--R + amount--K = K--(R+amount) = K--R'
     *     --------------- T --- K--R ------------------ R --- AIP ------ 2e25---------------------------
     *     T --- K--2e25 = SHARE_PHYSICAL_CAP(2e37)---
     *   -- ------------------------ _rescale ------------------------newShares > anchorCap
     *     --- floor(amount--T/R) > amount--K --- amount--T/R --- amount--K + 1 --- T/R > K
     *     --- T > K--R---T --- K--R --------------------------- _rescale --------- tNew(=K--R) < totalShares(=T)---
     *     tokensInPool > 0 --- mulDiv ---------------------totalShares > 0 ------------------------------
     *   -- ------------------amount --- 2e25---AIP ------------------K=1e12 --- anchorCap --- 2e37---
     *     K--tokensInPool --- 1e12--2e25 = 2e37------------ uint256 --------- 40 ---------------
     * ------------newShares = min(------------------, amount -- K)------------------------------------------------
     */
    function _mintPoolShares(SharePool storage p, uint256 amount, uint8 anchorTrigger)
        internal
        returns (uint256 newShares)
    {
        if (p.totalShares == 0) {
            return amount; // ---------1 AIP = 1 ---------------------------------------
        }
        // ------------------------------------------mulDiv ------------------------------ panic---
        newShares = Math.mulDiv(amount, p.totalShares, p.tokensInPool);
        // ===== U2 ------------------------ 1 AIP --------- K=1e12 ------------------------------------=====
        uint256 anchorCap = amount * SHARE_ANCHOR_K; // ---2e25--1e12=2e37 ---------
        if (newShares > anchorCap) {
            // T/R > K --- --------------------------- K--R------------------------------------------------------------
            _rescale(p, SHARE_ANCHOR_K * p.tokensInPool, anchorTrigger); // ------------=1 / backup ------=11
            newShares = anchorCap; // --------- T=K--R --- mulDiv(amount, K--R, R) --------- amount--K
        }
    }

    /**
     * _creditPoolShares --- ------------------------------B3 ---------deposit --- _addConsumedToPool ------
     * --------------------------- --- ---------------
     * ----------------------------------------------------------------------------
     * ------------mainPool.tokensInPool += aipAmount---mainPool.totalShares += newShares---
     *        custodianShares[to] += newShares---custodianUsdtDebt[to] += newShares -- uPS -- P
     * ------------------_syncCustodianEpoch(to) ---------------------------------------------------------------------
     *        ---------------------------------------------------------------------------------------------
     * ------------------------deposit ------------"---------------------------------"---_addConsumedToPool ------------
     *        "---------------------------------"------------ SSTORE ---------------------------/------------------------
     *        ---------------------SSTORE ---------------------------------------------------------------------
     */
    function _creditPoolShares(address to, uint256 newShares, uint256 aipAmount) private {
        mainPool.tokensInPool += aipAmount; // ------ AIP ------
        mainPool.totalShares += newShares; // ---------------
        custodianShares[to] += newShares; // ------------------
        custodianUsdtDebt[to] += Math.mulDiv(newShares, mainPool.usdtPerShare, PRECISION); // --------------------------------------------- USDT---mulDiv ---------------------
    }

    // P1: Changed to accounting-based - no auto USDT transfer --- ---------------------------------

    /**
     * _walkEpochChain --- --------------------------------------Phase-2 ------------------ _migrateAcrossEpochs
     * --- backup --- _settleBackupChain ------------------ --- ------------------------------ storage ------------------
     * ----------------------------------------------------------------------------
     * ---------------"fromEpoch ------------------ + ---------"------------ [fromEpoch, p.epoch) ---------------
     *        ------------------------------------------------------ (------------ run, --------------- settled,
     *        ------------------ lastSnap)--------------- internal view ------------------------------------
     *        ------------------ _syncCustodianEpoch / --------- getCustodianInfo------ backup ---------
     *        claim() / --------- getStakingFullInfo() ------------------------------------------------------
     * --------------------------- e ------------ (num[e], den[e]) ------"--------- e --------- e+1"------------
     *        --------- = mulDiv(---------, num[e], den[e])---
     *        den==0 --- num==0 --- --------- --- ---------------
     *        --------------------------------------- 0/0------ --------------------------------------------------------- I9------
     * ---------------------------------C1 ------------------------------------------"------------"------------------------------
     *   ------------------ usdtPerShare------------"------------ --- ------------------------"--------------- USDT ---------
     *   --------------- 0 --------- 0.02 USDT/--------------------------------------------- uPS ---------
     *   0.03--------------------------------- 0.02~0.03 ---------------------"--------- = --------- -- 0.03"---------------
     *   C1 ------------------------------------------------"------------------------------------------"--------- -- ------------
     *   ---------------------------------------------------------------------------------= ------[p.epoch-1]------------
     *   --- lastSnap ------------------ 0.02~0.03 ------------------------------
     * ---USDT --------------------------------------------------- I4--------------------------------- uPS---------------------
     *   ------------------ S_last--------------- (run, settled)---
     *   -- --------------------------- = settled + run -- (uPS --- S_last) -- P
     *     ------settled ------"------------------ + ---------------"---------------------------------------------------------
     *     ---------------S_last --- uPS--------------------------------------------- -- ------------------------
     *   -- ------------------------------------------------ = run -- uPS -- P --- D_new
     *     = run -- (uPS --- S_last) -- P--------- D_new = run -- S_last -- P------
     *   -- ---------------------settled ---------------------------------------------------
     *     run -- (uPS --- S_last) ---------------------------------------------------------------------------
     * ---------------------
     *   -- ------------ mulDiv(run, ------[fromEpoch], P) --- debt---debt ---------------/---------
     *     ---= ------ -- --------------- uPS ------------------uPS --------------------- --- ------
     *     ------[fromEpoch] --- --------- uPS --- debt ---------------------------------
     *   -- ------------------------------------[e] --- ------[e-1]------uPS ------------ --- ------------ --- --- --- 0---------------
     * ---gas ------------------------Q4 --------------------------------------------- = p.epoch --- fromEpoch---
     *   ------------------------------------------------------------------------------------------------------------------
     *   ------ break------------------------------------------------------------------------------------------------------
     *   7 ------------RESCALE_COOLDOWN------------------ 5000+ ------------------------------------------------
     *   ---------------------------------------------------------------------------------------"------------ + ------------"
     *   ------------------------------
     * --------------------------------- run==0------------------ break------------------------------------------------
     *   ------------------ 0------------------ gas------------------------------------------------ --- 1~2 ---------------
     * ------------shares=------------------debt=------------------fromEpoch=------------------------------------
     *        fromEpoch < p.epoch------------------------
     * ------------run=------------------------------------------settled=------------------------------------------------
     *        lastSnap=---------------------run==0 ------ 0---------------------------------------------
     *        ------------D_new = mulDiv(run, lastSnap, P)------------------ uPS------ C1 ------------
     *        ------------------------backup---earned += mulDiv(run, uPS --- lastSnap, P)---
     */
    function _walkEpochChain(SharePool storage p, uint256 shares, uint256 debt, uint256 fromEpoch)
        internal view returns (uint256 run, uint256 settled, uint256 lastSnap)
    {
        // ------------ [fromEpoch, p.epoch) ------------------------------------------C1 ---------
        run = shares; // ---------------------------------------------------------"---------------------"---------
        // ------------------------------------ = ------ -- --------------- --- ------------
        // ------------------debt = ------ -- ---------uPS------------------------------uPS ------------ --- ------ ------[fromEpoch] --- ---------uPS
        settled = Math.mulDiv(run, p.epochEndPerShare[fromEpoch], PRECISION) - debt;
        uint256 e = fromEpoch;
        while (e < p.epoch) { // ------------------------------------------------------------------------------------------
            uint256 num = p.scaleNumPerEpoch[e]; // ------ e ------------------T_new------------/--------------------- 0---
            uint256 den = p.scaleDenPerEpoch[e]; // ------ e ------------------T_old------------------------ 0---
            // den==0 --- num==0 --- --------------------------------------------------- ---------------
            // ---------------------------------mulDiv ------------------------------ panic---
            run = (den == 0 || num == 0) ? 0 : Math.mulDiv(run, num, den);
            uint256 prevEnd = p.epochEndPerShare[e]; // ------------------------------------------------
            unchecked { ++e; } // e ------------------ p.epoch ---------------------------
            if (run == 0) break; // ------------------ 0--------------------------------------------- gas---
            if (e < p.epoch) {
                // ------------------------------------------------ = run ------------------- P---
                // uPS ------ --- ------[e] --- ------[e-1] --- --------- --- 0---------------
                // --------------------------------------- run ---------------------------------------/------------------
                // ------------------------------------------------------------------------------ C1 ------------------
                settled += Math.mulDiv(run, p.epochEndPerShare[e] - prevEnd, PRECISION);
            }
        }
        // ---------------------= ------[p.epoch-1]---------------------------------------------------
        // run==0--------------------------------- 0--------------- run>0 ---------------
        lastSnap = run == 0 ? 0 : p.epochEndPerShare[p.epoch - 1];
    }

    /**
     * _syncCustodianEpoch --- --------------------- epoch---------------------------U3.3 + C1 ---------
     * ----------------------------------------------------------------------------
     * --------------------- epoch --------- mainPool.epoch ------------------------------------------------------
     *        --------------------------- custodianPendingUsdt------------------------------------------------
     *        ------------------------------epoch ------------------------------------------------------------------
     *        ------------------------deposit/withdrawAll/claimUsdt------------------------------O(1)/---------
     * ------------------------------"---------"---------------------------------------------------------------------------------
     *        --------------- _walkEpochChain ------------------------------------------------------------------
     * --------------------------------------------------------------------------- I9---------------------------
     *        mainPool.scaleNumPerEpoch / scaleDenPerEpoch ---------------------------mapping ------ 0/0---
     *        --- _walkEpochChain ---------------------------------------run=0 --- break
     *        --- newShares=0---newDebt=0---settled = --------- -- ------[---------] -- P --- ---------
     *        ------------ pending ------------------------ --------- = "--------------------- + ------------------ pending"---
     *        ------------------------------------------------------custodianEpoch == mainPool.epoch------------------------
     *        ------------------
     * ------------------------ pending---settled > 0 ------------------ SSTORE------------------/------/---------
     *        ------------------------------------------------------------------internal ---------------------------------
     */
    function _syncCustodianEpoch(address addr) internal {
        if (custodianEpoch[addr] != mainPool.epoch) { // epoch ---------------------------------------
            // ---------------_walkEpochChain ---------------------------------------
            (uint256 newShares, uint256 settled, uint256 lastSnap) =
                _walkEpochChain(mainPool, custodianShares[addr], custodianUsdtDebt[addr], custodianEpoch[addr]);
            if (settled > 0) {
                // Record pending USDT instead of auto-transferring --- --------- pendingUsdt------------------
                custodianPendingUsdt[addr] += settled;
            }
            custodianShares[addr] = newShares; // ------------------------------------------ --- 0---------------------
            // --------------- = --------- -------------------------------------------- uPS---C1 ---------------------------
            // newShares==0------------------ lastSnap==0 --- mulDiv ------ 0------------"------------"------------
            custodianUsdtDebt[addr] = Math.mulDiv(newShares, lastSnap, PRECISION);
            custodianEpoch[addr] = mainPool.epoch; // ------ epoch
        }
    }

    /**
     * deposit --- ------------ AIP
     * ----------------------------------------------------------------------------
     * --------------------- AIP ------------------------------------------------------------ USDT
     * ------------------------------ approve AIP ------------
     * ------------aipAmount=------ AIP ------------------------------------------ POOL_DUST_THRESHOLD=
     *           1e12 wei=0.000001 AIP--------------------------------------- ---1--------- DustDeposit---
     * ------------------totalShares=0 --- 1:1------------------ newShares = aipAmount -- totalShares / tokensInPool---
     *           U2 --------------------------- aipAmount -- SHARE_ANCHOR_K ---------------T ------ K--R---------------------
     * ---------------_advanceEpochIfDrained------------------ epoch------ _syncCustodianEpoch --- ---------------------
     * ------------Deposited
     */
    function deposit(uint256 aipAmount) external {
        _checkNotPaused(); // ------------------------------------------------------------------------------------ withdrawAll ---------------
        _enterNonReentrant(); // L2 ------------------ private --------------------- modifier ---------------------------------
        // ===== -------------------------------------------- =====
        // ------------aipAmount ------------ POOL_DUST_THRESHOLD---1e12 wei = 0.000001 AIP------
        //   0 < 1e12 ------------------------------------------------------ ZeroAmount ---------------------------
        // --------------------------------------------------------------- --- ---------------------------------------
        //   "---------------------------"--------- revert--------- _advanceEpochIfDrained ---
        //   "---1e12 ------------"------------------------------1e-6 AIP ---------------------------------
        //   ------------ ~1e-7 USDT------ 10 USDT ------------------------------------
        // ---------------------------------------------"------"------------"------"------------------------------
        //   ------ operator --- consume ------------------------------------ 1:1 ---------------
        //   totalShares --------- 1------------------------ 1e12 --------------------- 0 ---------
        //   ------------------------------------------------------------------------------
        if (aipAmount < POOL_DUST_THRESHOLD) revert DustDeposit();

        _advanceEpochIfDust(mainPool, true); // ---------------/------------------ epoch---------------------------

        // ------------------------ U2 --------------------- deposit --- _addConsumedToPool ---------------------
        // ------------------------ _mintPoolShares---Phase-2 ------------------------------------------------
        // ------------------U3.4------------------------"--- ns"---------"1e60 ------/------/_syncCustodianEpoch"
        // ------------------------------------------------------ epoch ---------------------------
        // _syncCustodianEpoch ---------------------------------------------------------------------------------------
        uint256 newShares = _mintPoolShares(mainPool, aipAmount, 1); // anchorTrigger=1 ------------
        // ===== --------------------------0 ---------------------------------------=====
        // --------------------------------------------------- 0 ---------newShares==0 --------------------- AIP
        //   ---------------------------------------withdrawAll ------"--------------------- 0"------ revert
        //   ---InsufficientShares--------------- 100% ---------------
        // ---------------------------------operator ------------------------------------------------
        //   ---_advanceEpochIfDrained ------ totalShares=0--------- r --- 1e12 ------------------
        //   --------------- _addConsumedToPool---consume --------------------------------------- 1:1
        //   --------- --- totalShares --------- 1------ r=1e12---operator ------ m=1------
        //   T=1---R=1e12+1--------------- a=1e12 ------------------------
        //   newShares = floor(1e12 -- 1 -- (1e12+1)) = 0------------------------
        // ---------------------------"------"---------------"------"---------newShares --- 1 --- ---------
        //   --------------------------------------------------- floor ------------ < 1 ------------ --- ------
        //   ------ --- 1e-6 AIP------------------------------newShares == 0 ------------------------
        //   ------ DustDeposit ------------------------------------------------------ = ---R/T---
        //   --------------- R = 1e12+1--------------- 1 wei------
        // --------------------- _addConsumedToPool---operator ---------------------------------------
        //   ------------ 365 ------------------------------T<R ------------------------ 0 ---------------
        //   operator --------- 1 wei --------------------------------- revert ---------------------------
        //   ---------------
        // ------------------------------------------------------------T --- R------------ --- 1e12 ---------------
        //   --- 1e12 --------------------------------------- SHARE_SATURATION_CAP ---------------------
        //   ---------------------------------------------------------------
        if (newShares == 0) revert DustDeposit();
        // ---------------------------------------------------------SHARE_SATURATION_CAP=1e60------------------------
        // ------------------------------------------------------------------------------------------
        // ---U2 --------------------------------------------------- T --- K--(R+------) --- 2e37---1e60 ------------
        // ---------------------------------"---------------------"------------------------------------------------------
        if (mainPool.totalShares + newShares > SHARE_SATURATION_CAP) revert ShareSaturation();

        token.safeTransferFrom(msg.sender, address(this), aipAmount); // ------ AIP

        _syncCustodianEpoch(msg.sender); // ------ epoch------------------------ USDT---

        _creditPoolShares(msg.sender, newShares, aipAmount); // ------------------B3 ---------------/------/------/---------------

        emit Deposited(msg.sender, aipAmount, newShares);
        _exitNonReentrant(); // ------
    }

    /**
     * withdrawAll --- ---------------------AIP + USDT---
     * ----------------------------------------------------------------------------
     * --------------------------------------------- AIP --- USDT --------------- epoch ---------
     * ---------------------------------------------
     * --------------------------------------------- totalShares/tokensInPool--------- AIP --- USDT
     * ------------Withdrawn
     */
    function withdrawAll() external {
        _enterNonReentrant(); // L2 ---------
        _syncCustodianEpoch(msg.sender); // ------ epoch
        uint256 shares = custodianShares[msg.sender];
        if (shares == 0 && custodianPendingUsdt[msg.sender] == 0) revert InsufficientShares(); // ------------------

        bool isActive = custodianEpoch[msg.sender] == mainPool.epoch; // ------------ epoch ------

        uint256 effectiveTokens;
        if (isActive && mainPool.totalShares > 0) { // --------------------------------- AIP---mulDiv ---------------------
            effectiveTokens = Math.mulDiv(shares, mainPool.tokensInPool, mainPool.totalShares);
        }

        uint256 pendingUsdt = _accruedUsdt(shares, custodianUsdtDebt[msg.sender]); // ------ epoch ------ USDT---B2 ---------------

        custodianShares[msg.sender] = 0; // ------------
        custodianUsdtDebt[msg.sender] = 0; // ------------

        if (isActive) { // ------------------------
            mainPool.totalShares -= shares;
        }
        mainPool.tokensInPool -= effectiveTokens; // ------------ AIP

        if (effectiveTokens > 0) { // ------ AIP
            token.safeTransfer(msg.sender, effectiveTokens);
        }
        // P1: Include accumulated pending USDT from previous epochs --- ------ epoch --------------- USDT
        uint256 totalUsdtToTransfer = pendingUsdt + custodianPendingUsdt[msg.sender];
        custodianPendingUsdt[msg.sender] = 0; // ------ pending
        if (totalUsdtToTransfer > 0) { // ------ USDT
            usdt.safeTransfer(msg.sender, totalUsdtToTransfer);
        }

        emit Withdrawn(msg.sender, effectiveTokens, totalUsdtToTransfer);
        _exitNonReentrant(); // ------
    }

    // ======================= ---------------U4--------------------------------------- =======================
    // ------------------------------------------U2---------------------------------------/------------------------------
    //   ---------T/R ------------------ 1e60 ------------------------------------------------------ totalShares
    //   --------- 1:1 ---------T := R--------------------------- _rescalePool ---------------------------------
    //   ------------------------------------------------------I3------------------------------+---------------------
    //   ---------------I4------------------------------------------------------------------------------------------------
    // ---------------------Q4 ---------------
    //   -- owner ---------emergencyRescalePool---------------------------------owner ------------"------------
    //     --------- bug"------------------------ T --------- 2e37------------------------------------------------
    //     --------------------------------------- timelock/------------------------------------
    //   -- ------------------emergencyRescalePoolPublic------------------------------------------------
    //     --------- T > SHARE_PHYSICAL_CAP=2e37---+ 7 ------------------------------------ revert---
    //     ---------------2e37 = K--AIP ---------------------------------------------------------------------------
    // ------------------I8------T_new = tokensInPool --- --------- totalShares == tokensInPool---
    //   --- 1 --------------- 1 AIP---1:1------
    // ---triggerType ---------2=--------------- / 3=------ owner / 12=backup --------- / 13=backup owner
    //   ---1/11 --------------------------------- PoolRescaled ---------------------------------------

    /**
     * _rescaleGuard --- ------------------------------------------A3 ------------ 4 ------------------------------
     * ------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------poolTokens>0---------------------totalSh>0------------ 1:1
     * ---totalSh > poolTokens------------ 1:1 ------------------------------------ backup ------------------
     * T<R --------------------------------------------------------------- revert InvalidRescale---
     * ---------------------------/backup ---------------------------------------------------------------------------
     * ---internal pure---------------------------------------------------------------------
     */
    function _rescaleGuard(uint256 poolTokens, uint256 totalSh) private pure returns (bool) {
        return poolTokens != 0 && totalSh != 0 && totalSh > poolTokens;
    }

    /**
     * _ownerRescale --- owner ---------------------------------------------------------/backup ------ owner
     * ------------------------"------ + ------"------ --- --------------------- storage ------------------
     * ----------------------------------------------------------------------------
     * ------------A3 --------------------- / --- 1:1 --- revert InvalidRescale------------------ p ---
     *        totalShares --------------- 1:1 ---------tNew = p.tokensInPool------
     * ------------PoolRescaled(..., triggerType)---triggerType ---------------------------------
     */
    function _ownerRescale(SharePool storage p, uint8 triggerType) private {
        if (!_rescaleGuard(p.tokensInPool, p.totalShares)) revert InvalidRescale(); // ------/--- 1:1---A3 ---------------
        _rescale(p, p.tokensInPool, triggerType); // --------------- tNew < totalShares
    }

    /**
     * _publicRescale --- ---------------------------------------------------/backup ------ public ------
     * ---------------"------ + ------ + ------ + ------"------ --- ---------------
     * ----------------------------------------------------------------------------
     * ------------------p.totalShares > SHARE_PHYSICAL_CAP(2e37 = K -- AIP ------------)------U2
     *        ------------------------------------------------------ T --- K--R --- 2e37---------------------------
     *        ------/------------------------------------------------------------------------------------------------
     *        --- revert------------------
     * ------------block.timestamp --- p.lastPublicRescale + RESCALE_COOLDOWN(7 ---)------------
     *        ------------------------------------------------------------------------------------ 0 ------------------
     *        ---/backup ------------------------------------------------------------------------
     * --------------------- lastPublicRescale ------------------_ownerRescale --------------------- revert---
     *        ------------------------------------------"------------ = ------------"------------------------------------
     * ------------PoolRescaled(..., triggerType)
     */
    function _publicRescale(SharePool storage p, uint8 triggerType) private {
        if (p.totalShares <= SHARE_PHYSICAL_CAP) revert InvalidRescale(); // ---------------------------------------
        if (block.timestamp < p.lastPublicRescale + RESCALE_COOLDOWN) revert InvalidRescale(); // 7 ---------------
        p.lastPublicRescale = block.timestamp; // ------------ = ---------------------------revert ---------------------
        _ownerRescale(p, triggerType); // A3 ------ + ------------------------
    }

    /**
     * emergencyRescalePool --- ------ owner ------------
     * ----------------------------------------------------------------------------
     * --------------------- totalShares --------------- 1:1 --------------------- _ownerRescale------
     * --------------- owner---onlyOwner--------------- A3 ------------------/------------------
     * ------------PoolRescaled(..., triggerType=3)
     */
    function emergencyRescalePool() external onlyOwner {
        _ownerRescale(mainPool, 3); // triggerType=3 ------ owner ------
    }

    /**
     * emergencyRescalePoolPublic --- ------------------------------owner ---------------------------
     * ----------------------------------------------------------------------------
     * --------------- owner ------------------------------------------------------------SHARE_PHYSICAL_CAP---
     *        ------ 7 ------------------------------ _publicRescale---------------------------
     * ------------------------------------------------------PoolRescaled(..., triggerType=2)
     */
    function emergencyRescalePoolPublic() external {
        _publicRescale(mainPool, 2); // triggerType=2 ---------------------
    }

    /**
     * emergencyRescaleBackupPool --- backup --- owner ---------------emergencyRescalePool ------------
     * ----------------------------------------------------------------------------
     * --------------- backup --- totalShares --------------- 1:1 --------------------- _ownerRescale------
     *        ------------------------ claim ------------------------------------------------------
     * --------------- owner---onlyOwner------------------PoolRescaled(..., triggerType=13)
     */
    function emergencyRescaleBackupPool() external onlyOwner {
        _ownerRescale(backupPool, 13); // triggerType=13 backup owner ------
    }

    /**
     * emergencyRescaleBackupPoolPublic --- backup ---------------------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------- backup owner --------------------------------------------- backup ---------------
     *        ------------------------------------------------ backupPool.lastPublicRescale---
     * ------------------------------------------------------PoolRescaled(..., triggerType=12)
     */
    function emergencyRescaleBackupPoolPublic() external {
        _publicRescale(backupPool, 12); // triggerType=12 backup ---------------
    }

    /**
     * claimUsdt --- ------------ USDT ------------------ AIP---
     * ----------------------------------------------------------------------------
     * --------------------------------- USDT --------------- AIP ---------------------
     * ---------------------------------------------
     * ------------------------------------------ pending--------- USDT
     * ------------UsdtClaimed
     */
    function claimUsdt() external {
        _enterNonReentrant(); // L2 ---------
        _syncCustodianEpoch(msg.sender); // ------ epoch
        uint256 shares = custodianShares[msg.sender];
        uint256 pendingUsdt = _accruedUsdt(shares, custodianUsdtDebt[msg.sender]); // ------ epoch ---------B2 ---------------
        // P1: Include accumulated pending USDT from previous epochs --- ------ epoch ------
        uint256 totalUsdtToTransfer = pendingUsdt + custodianPendingUsdt[msg.sender];
        if (totalUsdtToTransfer == 0) revert ZeroAmount(); // ---------

        // ---------------------B2 ------------------------ debt = mulDiv(shares, uPS, P)------
        // pendingUsdt = mulDiv(shares, uPS, P) --- debt------ debt += pendingUsdt ---------
        // ---------------------debt + pending --- mulDiv --------------------------------------- mulDiv ---------------------
        custodianUsdtDebt[msg.sender] += pendingUsdt;
        custodianPendingUsdt[msg.sender] = 0; // ------ pending
        usdt.safeTransfer(msg.sender, totalUsdtToTransfer); // ------ USDT

        emit UsdtClaimed(msg.sender, totalUsdtToTransfer);
        _exitNonReentrant(); // ------
    }

    /**
     * _chargeUsdtFee --- ------ 1% ------------------ owner
     * ----------------------------------------------------------------------------
     * ------------------------ USDT --------------- 1% --------------------- ownerUsdtFees
     * ------------usdtAmount=------ USDT ------
     * ------------net=------------------------------= usdtAmount -- 99%---
     */
    function _chargeUsdtFee(uint256 usdtAmount) internal returns (uint256 net) {
        uint256 fee = usdtAmount * SELL_FEE_BPS / BPS; // 1% ---------
        ownerUsdtFees += fee; // --------- owner ------
        return usdtAmount - fee; // ------------
    }

    /**
     * _distributeReferralFee --- ------------------------ vs ------------
     * ----------------------------------------------------------------------------
     * ---------------------------------lockedBalance --- holdThreshold--------------------- referrerRewards---
     *        ------------ ownerReferralRewards------ owner---
     * ------------referrer=------------------fee=AIP ---------isActive=---------------------
     * ------------ReferralFeeDistributed------------------------
     */
    function _distributeReferralFee(address referrer, uint256 fee, bool isActive) internal {
        if (isActive) { // ---------------------------------------
            referrerRewards[referrer] += fee;
            totalPendingReferralRewards += fee;
            referrerLastRewardTime[referrer] = block.timestamp; // ---------------------------365 ------------------
            emit ReferralFeeDistributed(referrer, msg.sender, fee);
        } else { // ------------------------------ owner
            ownerReferralRewards += fee;
        }
    }

    /**
     * _bindReferrer --- ---------------------------------------------------------------------------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------------------------------------------------------------ referrerOf[user]---
     *        -- --------------------------- referral --------------- --- 50 AIP------ ------------------------------ inviteeCount
     *        -- --------------------------- referral ------------------------ --- 50------ ---------------------------------------------
     *        -- --------- / --------------- / --------------------------- --- ------------------------
     *        --------------------------------------------------------------- owner------ _getActiveReferrer ------------
     *        ------ false --- --------- ownerReferralRewards------------------------------------------------
     * ------------user=---------------------------referrer=------------------------ 0=---------------
     *        canBind=--------------------------------------------------------------------- canBind ---------
     *        referrerOf[user]==address(0)------------------------------------------------------ referrerOf
     *        ---------------------------------------------------------------------------
     *          ------------------ 2026-10-10--------------------------------- hasBoughtFromPool[user]==false---
     *          ---------------------------------------------------inviteeCount ------------------------------------------------
     *          ------------------------ 2026-10-10 ------------------"---------------------------------------------------------
     *          ------"------------------------------------------------------------ 50 AIP ------------------------------------
     *          --------------------------------------------------------- owner --------------- owner ------------------------
     *          ------------------------------ owner() ------
     * ------------------canBind ------ ------referrer==0 / referrer==user / ------------------ --- ---------
     *   --------------- = appAccess[referrer][REFERRAL_APP_ID] --- lockedBalance[referrer] --- holdThreshold---
     * ---------------referrerOf[user] = referrer------------------ REFERRAL_OWNER_SENTINEL------------------
     *   ------ inviteeCount --------------------------- emit ReferralBoundToOwner ---------------
     */
    function _bindReferrer(address user, address referrer, bool canBind) internal {
        if (!canBind) return; // ---------------referrerOf ---------------------------------------
        if (referrer != address(0) && referrer != user && appAccess[referrer][REFERRAL_APP_ID] && lockedBalance[referrer] >= holdThreshold) {
            referrerOf[user] = referrer; // ---------------------------------------------------
            referrerInviteeCount[referrer]++; // ------------------
            return;
        }
        // --------- / ------ / --------------------------- --- ---------------------------------------------------
        referrerOf[user] = REFERRAL_OWNER_SENTINEL;
        emit ReferralBoundToOwner(user);
    }

    /**
     * _getActiveReferrer --- ---------------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------------ referrerOf[user] ------------------------------
     * ------------------lockedBalance[boundReferrer] >= holdThreshold--------- AIP --- 50---
     * ------------boundReferrer=---------------------------------=------------------isActive=------------
     * ------------------REFERRAL_OWNER_SENTINEL ---------------------------/---------------------------------------
     *   ------ false------------------------------------ ownerReferralRewards--------------------------- SLOAD
     * ------------------ _distributeReferralFee / _chargeAppUnlockUsdt ------------------------ vs --- owner
     */
    function _getActiveReferrer(address user) internal view returns (address boundReferrer, bool isActive) {
        boundReferrer = referrerOf[user]; // ------------------------------------------ 0---------------------------
        if (boundReferrer == REFERRAL_OWNER_SENTINEL) return (boundReferrer, false); // --------------------------------------------------- SLOAD---
        isActive = boundReferrer != address(0) && lockedBalance[boundReferrer] >= holdThreshold; // ---------------------------------
    }

    /**
     * _chargeAppUnlockUsdt --- ------------------ USDT ------ 6 ------------------------/owner
     * ----------------------------------------------------------------------------
     * ------------------------------------------ USDT--------------------------- 6 ---------------------------------------------
     *        --------- owner--------------------------------------------------- owner
     * ------------user=------------cost=---------------------boundReferrer=---------------------isActive=---------------------
     * ------------referralAmount=------------------ USDT ------------------------ 0---
     * ------------
     *   - --------- cost>0---
     *     -- referralAmount = cost -- getReferralBps(boundReferrer) -- BPS---6 --------- 5%---80%---
     *     -- ownerAmount = cost - referralAmount
     *     -- owner --------- user --- owner()
     *     -- ------------------ user ---------------------------push ------------------ referrerUsdtLifetime
     *       --------------------- ReferralUsdtEarned
     *   - ---------cost --------- user --- owner()
     * --------- push ---------------USDT ------------------------------------------------------------------------------
     *   "--------------------- --- ---------------------------------------------------"---------------------------------
     *   ------------------------------------ gas------------------------------------------------------------ AIP ------
     *   ------------------ --- ------ + ------ + ---------------------"------------ --- --------------------- --- ------"
     *   ---------------------
     */
    function _chargeAppUnlockUsdt(
        address user, uint256 cost, address boundReferrer, bool isActive
    ) internal returns (uint256 referralAmount) {
        if (isActive && cost > 0) { // --------------------------------- 6 ---------------
            referralAmount = cost * getReferralBps(boundReferrer) / BPS; // --------------- USDT
            uint256 ownerAmount = cost - referralAmount; // owner ------ USDT
            usdt.safeTransferFrom(user, owner(), ownerAmount); // owner --------- owner
            usdt.safeTransferFrom(user, boundReferrer, referralAmount); // ---------------------------------------push---
            referrerUsdtLifetime[boundReferrer] += referralAmount; // ---------------------
            emit ReferralUsdtEarned(boundReferrer, user, referralAmount);
        } else { // --------------------------------------------- owner
            usdt.safeTransferFrom(user, owner(), cost);
        }
    }

    /**
     * _accrueBuyUsdt --- --------------- USDT ------------------B3 ---------_executePoolPurchase ------ 1 ---
     * ------ 2 --------------------------- --- ---------------
     * ----------------------------------------------------------------------------
     * --------------- 1% --------------------- owner ------------ --------------- USDT ---------------------------------
     *        --------------------- --------------- AIP--------------------------------- owner---
     * ------------usdtCost=------------ USDT---referralFee=--------------------- AIP---
     *        referrer=------------------isActive=---------------------
     * ---------------------------------------backup --------- _sellBackupTokens---backup ---------------
     *        backupUsdtPerShare ---------------------------------
     */
    function _accrueBuyUsdt(uint256 usdtCost, uint256 referralFee, address referrer, bool isActive) internal {
        uint256 usdtNet = _chargeUsdtFee(usdtCost); // --- 1% ------------------
        _accumulateUsdt(mainPool, usdtNet); // ---------------------------------------------------
        _distributeReferralFee(referrer, referralFee, isActive); // ------------
    }

    /**
     * _executePoolPurchase --- ---------------------------------pool ------ + backup ------------------------
     * ----------------------------------------------------------------------------
     * ------------------ tokensInPool --------------------------------- AIP ------------------ USDT ------------------------------
     * ------------aipAmount=------ AIP ---------usdtCost=------ USDT---buyerAmount=------------ AIP---------------------------
     *        referralFee=--------- AIP ---------boundReferrer=------------isActiveBoundReferrer=---------------------
     * --------- 1------------------totalShares > 0 --- tokensInPool >= aipAmount------
     *   - ------ tokensInPool --- ------/------/--------- --- --- buyerAmount ------------CEI------------------------
     *   - usdtNet = _chargeUsdtFee(usdtCost)---1% ------------------ owner---
     *   - usdtPerShare += usdtNet -- PRECISION -- totalShares------------ USDT ---------
     *   - _distributeReferralFee --------------------------------------------- owner---
     * --------- 2--------------------- backup ---------------
     *   - fromPool = tokensInPool---------------------fromBackup = aipAmount - fromPool---backup ------------
     *   - --- aipAmount ------------ poolUsdt / poolBuyerAmount / poolReferralFee
     *   - --- fromPool > 0------ poolBuyerAmount --------------- tokensInPool---pool ------------ usdtPerShare------ pool ---------------
     *   - --- fromBackup > 0---backupUsdtNet --- 1% --------------- _sellBackupTokens ------ backup ------
     *     --- backupBuyerAmount --------------- backup ---------------
     * ---------------tokensInPool / usdtPerShare / referrerRewards / ownerReferralRewards / ownerUsdtFees ---------
     */
    function _executePoolPurchase(
        uint256 aipAmount,
        uint256 usdtCost,
        uint256 buyerAmount,
        uint256 referralFee,
        address boundReferrer,
        bool isActiveBoundReferrer
    ) internal {
        // ===== M1a --------------- 1 ------ totalShares > 0 ------ =====
        // ---------------totalShares==0--------------------------------------- --- ---------------------
        //   tokensInPool >= aipAmount --------------- 1--------- _accumulateUsdtPerShare ---
        //   totalShares==0 --------- panic---usdtRemainder / 0------------------------------------
        //   ------ 10 USDT ------------------------------------------------------------ 2---fromPool=0---
        //   ------ backup ------------------------------------ backup ---------------------------------------
        //   1:1 ------------------------------------------------------------------------------------------
        // ---CEI ------------------------/------/------/------------------------ token ---------------------------
        //   ------------ hook ---------------------------------------------------------------------------------
        //   nonReentrant ------------------------"------------------------------"---------------------
        if (mainPool.totalShares > 0 && mainPool.tokensInPool >= aipAmount) { // ------ 1------------------------------------M1a ---------
            mainPool.tokensInPool -= aipAmount; // ------------ AIP---CEI---------------
            _accrueBuyUsdt(usdtCost, referralFee, boundReferrer, isActiveBoundReferrer); // ---------+---------------+------------B3 ---------
            token.safeTransfer(msg.sender, buyerAmount); // --------------- AIP---CEI---------------
        } else { // ------ 2--------------------- backup ---------
            // ---------------------------------------------------------------------mainPool.totalShares==0------------
            // ------ --- --------------- AIP------------------------------------------------------------------
            // ------------ <1e-6 AIP--------------------------- 1:1 ------------------------------ backup
            // ------------------------------ mainPool.totalShares==0 ------------ panic---
            uint256 fromPool = mainPool.totalShares == 0 ? 0 : mainPool.tokensInPool; // ------------ AIP------------------------ 0---
            uint256 fromBackup = aipAmount - fromPool; // ------ backup --------- AIP

            uint256 poolUsdt = fromPool > 0 ? fromPool * usdtCost / aipAmount : 0; // --------------- USDT
            uint256 poolBuyerAmount = fromPool > 0 ? fromPool * buyerAmount / aipAmount : 0; // ---------------------
            uint256 backupBuyerAmount = buyerAmount - poolBuyerAmount; // backup ------------------
            uint256 poolReferralFee = fromPool > 0 ? fromPool * referralFee / aipAmount : 0; // ------------------

            if (fromPool > 0) { // ------------------CEI------------------------
                mainPool.tokensInPool -= fromPool;
                _accrueBuyUsdt(poolUsdt, poolReferralFee, boundReferrer, isActiveBoundReferrer); // ---------+---------------+------------B3 ---------
                token.safeTransfer(msg.sender, poolBuyerAmount);
            }

            if (fromBackup > 0) { // backup ------------
                uint256 backupUsdt = usdtCost - poolUsdt; // backup ------------ USDT
                uint256 backupUsdtNet = _chargeUsdtFee(backupUsdt); // backup --------- 1% ---------
                _sellBackupTokens(fromBackup, backupUsdtNet); // ------ backup ------ AIP
                token.safeTransfer(msg.sender, backupBuyerAmount); // ---------------
                uint256 backupReferralFee = referralFee - poolReferralFee; // backup ---------------
                _distributeReferralFee(boundReferrer, backupReferralFee, isActiveBoundReferrer);
            }
        }
    }

    /**
     * buyFromPool --- --------------------------------- AIP------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------maxUsdtCost ------------------------------------M3 ------------------
     *        ------------/------/--------- _buyFromPoolImpl ---------------------------------------------
     * --------------------- 3 ------------------------ = maxUsdtCost=0--------------------------------- viaIR
     *        --------- _buyFromPoolImpl --------------------------------------------------- 1.3KB ------
     *        ------------------------------ maxUsdtCost=0---"---------"---------------------------------
     * ------------maxUsdtCost=0 ---------"---------"------------------ _buyFromPoolImpl ------------
     *        ------------------------------------
     */
    function buyFromPool(uint256 aipAmount, address referrer, bool usePriceDrop, uint256 maxUsdtCost) external {
        _checkNotPaused(); // ------------------------------------------------------------------------ _buyFromPoolImpl ---------------------------------------------
        _buyFromPoolImpl(aipAmount, referrer, usePriceDrop, maxUsdtCost); // ---------------------internal ------------ msg.sender ---------
    }

    /**
     * _buyFromPoolImpl --- ------------------buyFromPool --------------- private ---------
     * ----------------------------------------------------------------------------
     * ------------------------------ private ------ + external ------------------------------------------------
     *   ------------------viaIR ---------------------------------------------------------------------------
     *   ------------------------------------------------------------ = --------------------------- = ------------------
     * ------------aipAmount=------------referrer=------------------usePriceDrop=------------------------------
     *        maxUsdtCost=------------------------ USDT ---------M3 ---------------0=------------
     * ---M3 ------------------------------------------------------------------------------------ totalUsdtVolume
     *        ---------------------------------------------maxUsdtCost ---------------------------------
     *        ------------------ExcessiveUsdtCost------------------------------------------------------
     *        ------------------------------------------------------------------------------------------------------------
     * ------------
     *   - aipAmount != 0---ZeroAmount---
     *   - usePriceDrop --------- PRICE_DROP_APP_ID ---------------PriceDropAccessDenied---
     *   - usePriceDrop ------totalUsdtVolume >= PRICE_DROP_VOLUME_THRESHOLD---PriceDropVolumeNotReached---
     *   - ------------ >= aipAmount---InsufficientPoolSupply------M1b ---------------------"------------"------------
     *     ------------------------------------------------------------------"--------------------- backup ------------"------------
     *   - ------------ == 0---EmptyPool---
     *   - usdtCost + 1e16 >= 10e18---BelowMinimumBuy--------- 10 USDT---1e16 ------------
     *   - maxUsdtCost != 0 --- usdtCost > maxUsdtCost---ExcessiveUsdtCost---
     *   - ---------------------------L2---------------------------------------------
     * ------------
     *   1. ------ _processYearBoundaries------------------------------------------------------------------------------------
     *   2. E1 ---------------_processYearBoundaries ------------------------------------------ totalUsdtVolume
     *      ------------------------------------------------------------------------------------------------ 1~2 --------- pow
     *   3. ------------------------------------lastBuyTimestamp ------------------------------------------------------------------------
     *   4. U1 ---------------------------------------------totalShares>0 --------------------- < TAIL_CLEAR_VALUE
     *      ---10 USDT------------ aipAmount := tokensInPool ---------------emit TailCleared---------------------------
     *   5. ------ usdtCost = aipAmount -- --------- -- (1 - discountBps)------------------------+ ------------
     *   6. buyerAmount = aipAmount -- 99%------ 1% --------- AIP------referralFee = aipAmount -- 1%
     *   7. --- USDT--------------------------- hasBoughtFromPool------------------------------ _executePoolPurchase
     *   8. ------ totalUsdtVolume--------- lastBuyTimestamp------------------
     *   9. ------------------P2 ---------------------------------------------------------
     *      weeklySub.onPoolPurchase(msg.sender, usdtCost)------------------ + ------------------------------------
     *      finaleSub.onPoolPurchase(msg.sender)------------------------------------------------------------
     *  10. ------------------ yearStartTime ---------
     * ------------PriceDropPurchased--------------- BoughtFromPool------------
     */
    function _buyFromPoolImpl(uint256 aipAmount, address referrer, bool usePriceDrop, uint256 maxUsdtCost) private {
        _enterNonReentrant(); // L2 ------------------------------------------------------------------
        if (aipAmount == 0) revert ZeroAmount(); // ------------

        if (usePriceDrop) { // ------------------------
            if (!hasAppAccess(msg.sender, PRICE_DROP_APP_ID)) revert PriceDropAccessDenied(); // ---------------------
            if (totalUsdtVolume < PRICE_DROP_VOLUME_THRESHOLD) revert PriceDropVolumeNotReached(); // ---------------------------
        }

        _processYearBoundaries(); // ---------------------floorPrice ---------
        // ------------ _processWeekBoundary()--------------------------------------------------- WeeklyRankingSub---
        //   --------------------- weeklySub.onPoolPurchase --------------------------- + ---------------------------------
        //   ---------------------------------------------------------

        // ===== E1 --------------------------------------------------------- =====
        // ---------------------_getEffectivePrice --------- totalUsdtVolume / currentFloorPrice /
        //   yearStartEffectivePrice------ totalUsdtVolume ---------------------------------------------------
        //   ------------------------------------------------------------------------------
        // --------------- gas------------------------------ usdtCost --------------------- _getEffectivePrice
        //   ------------ _processYearBoundaries ------------------------------------------ pow---_ln ---
        //   log10 ------ + atanh 20 --------- + _exp --------- + 15 --------- + ------------------
        //   --------------------------------- 1 --------- 1~2 --- pow------------------ gas------
        uint256 effPrice = _getEffectivePrice(); // --------- = max(---------, ---------)--------- PRICE_ABS_CAP

        uint256 discountBps;
        if (usePriceDrop) { // ---------------------------
            // --------------------------- lastBuyTimestamp ---------------------------
            if (priceDropWindowEnd > 0 && block.timestamp >= priceDropWindowEnd) {
                lastBuyTimestamp = priceDropWindowEnd;
                priceDropWindowEnd = 0;
                priceDropWindowDiscountBps = 0;
            }
            // --------------------------------------------------------------- elapsed ------------
            if (priceDropWindowEnd > 0) {
                discountBps = priceDropWindowDiscountBps;
            } else {
                uint256 elapsed = block.timestamp - lastBuyTimestamp;
                (discountBps,) = _getCurrentPriceDropDiscount(elapsed);
                if (discountBps == 0) revert PriceDropNotActive(); // ------------------------
            }
        } else { // ------------------------------------------------------------------
            // Close price drop window if active
            if (priceDropWindowEnd > 0) {
                priceDropWindowEnd = 0;
                priceDropWindowDiscountBps = 0;
            }
        }

        uint256 backupAvailable = backupPool.tokensInPool; // backup --------- AIP
        // ===== M1b ------------------------"------------------"--------- =====
        // --------------------------- tokensInPool---------------------_advanceEpochIfDrained ------
        //   totalShares --------------- ---1e-6 AIP ------------------ 1:1 ---------------------------------
        //   ------------------_executePoolPurchase ------ 2 --- fromPool = totalShares==0 ? 0 : ...---
        //   ------------------------------ backup ------------------------------------------------
        //   backupTokensInPool < aipAmount --- backupTokensInPool + ------ ------------------
        //   ------------------ _sellBackupTokens --------- InsufficientBackupSupply------------
        //   --------------------------------- DoS---------------------------------------------------------------
        //   ------------------------------------------------------ InsufficientPoolSupply---
        uint256 sellableFromPool = mainPool.totalShares > 0 ? mainPool.tokensInPool : 0; // --------------------------------- 0---
        uint256 totalAvailable = sellableFromPool + backupAvailable; // ---------------
        if (totalAvailable < aipAmount) revert InsufficientPoolSupply(); // ---------------------/---------------------------------
        // ------------------------ EmptyPool --------------- aipAmount --- 1---ZeroAmount ---------------
        //   totalAvailable == 0 --- totalAvailable < aipAmount---EmptyPool ------------------------
        //   ---doc-tests BUG-REG-008 --------------------------- InsufficientPoolSupply---------------
        //   ---------------------error EmptyPool ---------------ABI ------ + ------------------

        // ===== U1 ------------------------------------------=====
        // ------------------------------------------------------------"---------------------"------------------------ <
        //   TAIL_CLEAR_VALUE=10 USDT ------------------------------------ amt--T/R ---------------------A ------------
        //   ------------------------------"--- 1e-6 AIP"---------------------------"------ <10 USDT ---------------
        //   ------------"------------------------------------------
        // ---------------------------------"------------"------"------------"---------------------------"------ ---10 ---
        //   ------------------ <10 ------"------------------------------------------------I1---------------------------
        //   --------- totalShares > 0 --- tokensInPool == 0 --- tokensInPool -- --------- ---
        //   TAIL_CLEAR_VALUE(10 USDT)---
        // ------------------Q1 ---------------------withdrawAll ------ AIP ------------------ <10 USDT ------------
        //   ------------------------------------------------------------------------------------ > ---------------10 USDT---
        //   ------ backup --------------------------------------------------- R ---------------------------------------------
        //   --------------------------- U2 ------------------K ---------------------------
        // ------------------------------C2 ------------------------------ --- --------------- = --------- + ---------
        //   ------ ---10 USDT --------------------------- ---10--------------------- BelowMinimumBuy ---------
        //   --------------------- <10 USDT ------------------------ ---10 USDT ------------------------------------
        //   ------------------------------ <10 USDT --------- BelowMinimumBuy ------------------------------
        // ------------------Q2 ---------------------------------------------------------------------------------------------
        //   ------------------------------------------------------------------------------------------------
        // ---aipAmount --------------------------------- memory ------------------------------------ usdtCost---
        //   buyerAmount---referralFee---_executePoolPurchase ------------------------------------------------
        //   ---------------------------------------------------------
        if (mainPool.totalShares > 0 && mainPool.tokensInPool > aipAmount) {
            uint256 remainingAfter = mainPool.tokensInPool - aipAmount; // --------------------------- tokensInPool > aipAmount------ >0---
            // ------------------------------------Q2 ---------E1 ---------------------------------------------------------------------------------------------------
            uint256 tailValue = Math.mulDiv(remainingAfter, effPrice, PRECISION);
            if (tailValue < TAIL_CLEAR_VALUE) {
                aipAmount = mainPool.tokensInPool; // --------------------------- usdtCost/buyerAmount/referralFee ------------------------------
                emit TailCleared(msg.sender, remainingAfter, tailValue);
            }
        }

        // ------------------------------------------------------ PRICE_DROP_WINDOW_DURATION---
        // Open window if not yet opened (price drop only)
        if (usePriceDrop && priceDropWindowEnd == 0) {
            priceDropWindowEnd = block.timestamp + PRICE_DROP_WINDOW_DURATION;
            priceDropWindowDiscountBps = discountBps;
        }

        // ------ = ------ -- ------------E1 ------------------------------------------------------------------
        // ------------------ --PRECISION --- --BPS---------------------------------------------------------------
        // ---------------------------------------------------------------
        uint256 usdtCost = aipAmount * effPrice / PRECISION;
        if (usePriceDrop) {
            usdtCost = usdtCost * (BPS - discountBps) / BPS; // --------------- -- (1 - discountBps)
        }

        if (usdtCost + 1e16 < 10e18) revert BelowMinimumBuy(); // ------ 10 USDT---1e16 ---------
        // ===== M3 --------------------------------------------- =====
        // ------------------ BelowMinimumBuy ------------------------------------------------------------------
        //   ------------------------------------------------------------------------------------------------------
        //   ------------------------------------------------------------------------------
        // ---0 ------------maxUsdtCost == 0 ------------------------------------------------------ 0------
        if (maxUsdtCost != 0 && usdtCost > maxUsdtCost) revert ExcessiveUsdtCost(usdtCost); // ---------------------------------------------------------------------------------------

        uint256 buyerAmount = aipAmount * (BPS - REFERRAL_FEE_BPS) / BPS; // ------------ 99%
        uint256 referralFee = aipAmount - buyerAmount; // --------- 1% AIP

        usdt.safeTransferFrom(msg.sender, address(this), usdtCost); // --- USDT

        _bindReferrer(msg.sender, referrer, referrerOf[msg.sender] == address(0)); // ------------------------------------------------------------------------------------------------------------------ _bindReferrer ---------referrerOf --------- _getActiveReferrer --------------------- hasBoughtFromPool ---------------------------
        hasBoughtFromPool[msg.sender] = true; // ------------------------------------------------------------

        (address boundReferrer, bool isActiveBoundReferrer) = _getActiveReferrer(msg.sender); // ---------------------

        _executePoolPurchase(aipAmount, usdtCost, buyerAmount, referralFee, boundReferrer, isActiveBoundReferrer); // ------------

        totalUsdtVolume += usdtCost; // ------------------------------------------
        if (!usePriceDrop) { // --------------------- lastBuyTimestamp------------------------------
            lastBuyTimestamp = block.timestamp;
        }

        // ===== ------/------------------------P2 ------------------------------------------------ =====
        // ------------------------------migratePoolsToSubs --------------------- owner ------------------------
        //   ---"------------ --- migrate ------"---------------------weeklySub/finaleSub ------ address(0)---
        //   ------------------ revert---------------------------------------------------------/------------------------
        //   ------------------------------------------migrate --------------------------------------------- migrate
        //   ---------------------------------------------------------------------------
        // ------------------------------------------------------------
        //   -- ------------ _updateWeeklyVolume(msg.sender, usdtCost)------ totalUsdtVolume ------------
        //     ------------ ------------ + ------------------------------------------------------WeeklyRankingSub ------
        //     --- _processWeekBoundary --- _updateWeeklyVolume------
        //   -- ------------ if (totalUsdtVolume >= FINALE_POOL_VOLUME_THRESHOLD) { lastPoolTrader =
        //     msg.sender; lastPoolTradeTime = block.timestamp; } --- ---------------------------------
        //     FinalePoolSub.onPoolPurchase--------- totalUsdtVolume ---------------------------------------
        //     ---------------------------------------
        if (address(weeklySub) != address(0)) { // --------------------- migrate ------------------------
            WeeklyRankingSub(weeklySub).onPoolPurchase(msg.sender, usdtCost); // ------------ + ---------------------
        }
        if (address(finaleSub) != address(0)) { // --------------------- migrate ------------------------
            FinalePoolSub(finaleSub).onPoolPurchase(msg.sender); // ---------------------------------------
        }

        if (yearStartTime == 0 && totalUsdtVolume >= ANNUAL_FLOOR_VOLUME_THRESHOLD) { // ------------------------------------------------
            yearStartTime = block.timestamp;
            yearStartEffectivePrice = _getCurrentPrice();
            currentFloorPrice = 0;
        }

        if (usePriceDrop) { // ------------
            emit PriceDropPurchased(msg.sender, aipAmount, usdtCost, discountBps, referrer, referralFee);
        } else { // ------------------
            emit BoughtFromPool(msg.sender, aipAmount, usdtCost, referrer, referralFee);
        }
        _exitNonReentrant(); // ------
    }

    /* ------------ 3 --------------- buyFromPool(uint256,address,bool) ------------------------------
       buyFromPool ------------------------------------ = maxUsdtCost=0------------------------------ 0--- */

    /**
     * _getTier1Interval --- ---------------------------------------------3M USDT ------------
     * ----------------------------------------------------------------------------
     * ------------totalUsdtVolume >= VOLUME_MILESTONE_2---3M USDT------------ TIER1_INTERVAL_FAST---30 ------------
     *        ------------ PRICE_DROP_TIER1_INTERVAL---1 ---------
     * ------------------------------------------
     */
    function _getTier1Interval() internal view returns (uint256) {
        return totalUsdtVolume >= VOLUME_MILESTONE_2 // ------------------ 3M USDT
            ? PRICE_DROP_TIER1_INTERVAL_FAST // 30 ---------------------
            : PRICE_DROP_TIER1_INTERVAL; // 1 ---------------------
    }

    /**
     * _getCurrentPriceDropDiscount --- ------ elapsed ---------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------- elapsed--------------------------------------------------- (discountBps, tierIndex)
     * ---------------elapsed ---------------------
     *   - --- TIER5_INTERVAL --- (TIER5_DISCOUNT_BPS, 5)
     *   - --- TIER4_INTERVAL --- (TIER4_DISCOUNT_BPS, 4)
     *   - --- TIER3_INTERVAL --- (TIER3_DISCOUNT_BPS, 3)
     *   - --- TIER2_INTERVAL --- (TIER2_DISCOUNT_BPS, 2)
     *   - --- _getTier1Interval() --- (TIER1_DISCOUNT_BPS, 1)
     *   - ------ --- (0, 0)---------------
     * ------------discountBps=---------------------------tierIndex=---------------0 ---------------
     */
    function _getCurrentPriceDropDiscount(uint256 elapsed) internal view returns (uint256 discountBps, uint256 tierIndex) {
        if (elapsed >= PRICE_DROP_TIER5_INTERVAL) { // --- 5 ---
            return (PRICE_DROP_TIER5_DISCOUNT_BPS, 5);
        } else if (elapsed >= PRICE_DROP_TIER4_INTERVAL) { // --- 4 ---
            return (PRICE_DROP_TIER4_DISCOUNT_BPS, 4);
        } else if (elapsed >= PRICE_DROP_TIER3_INTERVAL) { // --- 3 ---
            return (PRICE_DROP_TIER3_DISCOUNT_BPS, 3);
        } else if (elapsed >= PRICE_DROP_TIER2_INTERVAL) { // --- 2 ---
            return (PRICE_DROP_TIER2_DISCOUNT_BPS, 2);
        } else if (elapsed >= _getTier1Interval()) { // --- 1 --------- 3M USDT ---------------
            return (PRICE_DROP_TIER1_DISCOUNT_BPS, 1);
        }
        return (0, 0); // ---------
    }

    /**
     * _addConsumedToPool --- operator --------- AIP ------------------------------------ AIP --- operator ---------
     * ----------------------------------------------------------------------------
     * --------------- operator ------ consume --------- AIP --------------------------------------------- operator --- custodian ------
     * ------------amount=--------- AIP ------
     * ------------
     *   1. _advanceEpochIfDrained--------------------- epoch---
     *   2. ------ newShares---
     *      -- totalShares==0 --- newShares = amount------------------
     *      -- ------ newShares = amount -- totalShares -- tokensInPool---------------
     *   3. _syncCustodianEpoch(operator) ------ epoch --------- USDT
     *   4. tokensInPool += amount---totalShares += newShares
     *   5. custodianShares[operator] += newShares---custodianUsdtDebt[operator] += newShares -- usdtPerShare -- PRECISION
     * ------------------------ AIP ------------------operator ------------ custodian ------
     */
    function _addConsumedToPool(uint256 amount) internal {
        _advanceEpochIfDust(mainPool, true); // ---------------/------------------ epoch---------------------------

        // ------------------------ U2 --------------------- deposit() ------ _mintPoolShares---Phase-2 ---------
        // ---------------------------------------------------------U3.4---------------"--- ns"------"1e60 ------/
        // _syncCustodianEpoch"--------------------- epoch ------operator --------- _syncCustodianEpoch
        // ------------------------------------------------------------------
        uint256 newShares = _mintPoolShares(mainPool, amount, 1); // anchorTrigger=1 ------------
        // ------------------ deposit() ---------SHARE_SATURATION_CAP------------------------------------------------
        // ---U2 --------------------------- 1e60 ---------------------------------------------------------
        if (mainPool.totalShares + newShares > SHARE_SATURATION_CAP) revert ShareSaturation();

        _syncCustodianEpoch(operator); // ------ operator --- epoch --------- USDT

        _creditPoolShares(operator, newShares, amount); // ------------------B3 ---------------/------/------/---------------
    }

    /**
     * consume --- operator --------- AIP --------------------------------- AIP ------ operator ---------
     * ----------------------------------------------------------------------------
     * ------------operator --- owner ------------msg.sender == operator || owner()------------ NotOperator
     * ------------aipAmount != 0---ZeroAmount---
     * ------------
     *   1. --- operator --- aipAmount AIP ------------
     *   2. --- _addConsumedToPool ------------------------ operator ------
     *   3. ------ Consumed ------
     * ------------Consumed(msg.sender, aipAmount)
     */
    function consume(uint256 aipAmount) external {
        _checkNotPaused(); // ------------------operator ---------------------------------------------------------------------------------
                          //   internal _addConsumedToPool--------------------------------- claimRewards ------------------
        _enterNonReentrant(); // L2 ---------
        if (msg.sender != operator && msg.sender != owner()) revert NotOperator(); // operator --- owner ---------
        if (aipAmount == 0) revert ZeroAmount(); // ------
        token.safeTransferFrom(msg.sender, address(this), aipAmount); // --- operator --- AIP
        _addConsumedToPool(aipAmount); // ---------------
        emit Consumed(msg.sender, aipAmount);
        _exitNonReentrant(); // ------
    }

    /**
     * appId --- --------------------------- bytes32 ------ ID---keccak256 ---------
     * ----------------------------------------------------------------------------
     * --------------------------------------------------------- bytes32--------- apps/appAccess ---------------
     * ------------name=---------------------------
     * ------------bytes32 --------------- ID
     */
    function appId(string memory name) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(name)); // --------------- ID
    }

    /**
     * registerApp --- ------------------owner ------------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------onlyOwner
     * ------------name=------------------ MAX_APP_NAME_LENGTH ------------cost=------------ USDT ------
     * ------------
     *   - apps[id].active --------- false------------------AppAlreadyExists---
     *   - name ------ > 0 --- --- MAX_APP_NAME_LENGTH---InvalidAppName---
     * ------------------ id --- ------ AppInfo---active=true------ push --- appList --- ------------
     * ------------AppRegistered(id, name, cost)
     */
    function registerApp(string calldata name, uint256 cost) external onlyOwner {
        bytes32 id = appId(name);
        if (apps[id].active) revert AppAlreadyExists(); // ------------
        if (bytes(name).length == 0 || bytes(name).length > MAX_APP_NAME_LENGTH) revert InvalidAppName(); // ------------------

        apps[id] = AppInfo({name: name, unlockCost: cost, active: true}); // ------------------
        appList.push(id); // ------------------

        emit AppRegistered(id, name, cost);
    }

    /**
     * setAppCost --- ------------------------------------
     * ----------------------------------------------------------------------------
     * ------------onlyOwner
     * ------------name=---------------cost=------------------
     * ------------apps[id].active --------- true---AppNotFound---
     * ---------------apps[id].unlockCost = cost
     * ------------AppCostUpdated(id, oldCost, cost)
     */
    function setAppCost(string calldata name, uint256 cost) external onlyOwner {
        bytes32 id = appId(name);
        if (!apps[id].active) revert AppNotFound(); // ------------------
        uint256 oldCost = apps[id].unlockCost;
        apps[id].unlockCost = cost;
        emit AppCostUpdated(id, oldCost, cost);
    }

    /**
     * toggleApp --- ------/------------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------onlyOwner
     * ------------name=---------------active=------------------
     * ------------apps[id].name ------------------------------------AppNotFound---
     * ---------------apps[id].active = active
     * ------------AppToggled(id, active)
     * --------------- setAppCost ---------toggleApp ------ name --------------------------------------------- active
     */
    function toggleApp(string calldata name, bool active) external onlyOwner {
        bytes32 id = appId(name);
        if (bytes(apps[id].name).length == 0) revert AppNotFound(); // ------------------------ name ---------------
        apps[id].active = active;
        emit AppToggled(id, active);
    }

    /**
     * getAppAccessInfo --- ------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------------------------------------
     * ------------user=---------------_appId=------ ID
     * ------------
     *   - apps[_appId].active --------- true---AppNotFound---
     *   - --- _appId == STAKING_APP_ID---rewardPool >= currentRewardPerUser--------- StakingPoolExhausted
     * ------------
     *   - _hasAccess---appAccess[user][_appId] && lockedBalance[user] >= holdThreshold---------------
     *   - _isUnlocked---appAccess[user][_appId]------------------------
     *   - _unlockCost---apps[_appId].unlockCost------------------
     */
    function getAppAccessInfo(address user, bytes32 _appId) external view returns (
        bool _hasAccess,
        bool _isUnlocked,
        uint256 _unlockCost
    ) {
        if (!apps[_appId].active) revert AppNotFound(); // ------------------
        if (_appId == STAKING_APP_ID) { // ------------------------------------------
            if (rewardPool < currentRewardPerUser) revert StakingPoolExhausted();
        }
        return (
            appAccess[user][_appId] && lockedBalance[user] >= holdThreshold, // ------------------------ + ---------
            appAccess[user][_appId], // ---------------
            apps[_appId].unlockCost // ------------
        );
    }

    /**
     * unlockApp --- --------------------------------- USDT ------------ 6 ------------------------/owner---
     * ----------------------------------------------------------------------------
     * --------------------------------------------------- appAccess ------
     * ------------_appId=------ ID
     * ------------
     *   - apps[_appId].active --------- true---AppNotFound---
     *   - appAccess[msg.sender][_appId] --------- false---------------------AlreadyUnlocked---
     *   - lockedBalance[msg.sender] >= holdThreshold---------------------InsufficientHoldBalance---
     * ------------
     *   1. ------ cost = apps[_appId].unlockCost
     *   2. ------------------
     *   3. _getActiveReferrer ---------------------
     *   4. _chargeAppUnlockUsdt ------ USDT ------ 6 --------------------------------------------------------- owner---
     *   5. ------ AppUnlocked ------------ referralAmount ------ > 0 ------------------------
     *   6. appAccess[msg.sender][_appId] = true
     * ------------AppUnlocked(msg.sender, _appId, cost, boundReferrer|address(0), referralAmount|0)
     */
    function unlockApp(bytes32 _appId) external {
        _checkNotPaused(); // ------------------------------------ USDT ---------------------------------------------------------------------
        if (!apps[_appId].active) revert AppNotFound(); // ------------------
        if (appAccess[msg.sender][_appId]) revert AlreadyUnlocked(); // ---------------

        uint256 cost = apps[_appId].unlockCost;
        if (lockedBalance[msg.sender] < holdThreshold) revert InsufficientHoldBalance(); // ---------------

        (address boundReferrer, bool isActiveBoundReferrer) = _getActiveReferrer(msg.sender); // ---------------------

        uint256 referralAmount = _chargeAppUnlockUsdt(msg.sender, cost, boundReferrer, isActiveBoundReferrer); // ---------------
        // --- emit ---------------A5------------------------referralAmount==0---------------/---------------
        // referrer --------- address(0)------------------------------
        emit AppUnlocked(msg.sender, _appId, cost, referralAmount > 0 ? boundReferrer : address(0), referralAmount);

        appAccess[msg.sender][_appId] = true; // ---------------
    }

    /**
     * lockAIP --- ------------ AIP --------- holdThreshold ------------------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------- holdThreshold --------- AIP ---------------------------
     * ------------
     *   - lockedBalance[msg.sender] < holdThreshold---------------------AlreadyLocked---
     *   - token.balanceOf(msg.sender) >= holdThreshold------------------InsufficientBalanceToLock---
     * ------------
     *   1. safeTransferFrom ------ holdThreshold ------ AIP
     *   2. lockedBalance[msg.sender] = holdThreshold
     *   3. totalLocked += holdThreshold
     *   4. ------ AipLocked ------
     * ------------AipLocked(msg.sender, holdThreshold)
     */
    function lockAIP() external {
        _checkNotPaused(); // ------------------------------------------------------------------------------------ unlockAIP ---------------
        if (lockedBalance[msg.sender] >= holdThreshold) revert AlreadyLocked(); // ---------
        uint256 userBalance = token.balanceOf(msg.sender);
        if (userBalance < holdThreshold) revert InsufficientBalanceToLock(userBalance, holdThreshold); // ------------

        token.safeTransferFrom(msg.sender, address(this), holdThreshold); // ------------
        lockedBalance[msg.sender] = holdThreshold; // ------------------
        totalLocked += holdThreshold; // ------------------

        emit AipLocked(msg.sender, holdThreshold);
    }

    /**
     * unlockAIP --- ------------------------ AIP------------------ AIP---
     * ----------------------------------------------------------------------------
     * --------------------------------------- AIP ---------------
     * ------------lockedBalance[msg.sender] != 0---------------------NoLockedAIP---
     * ------------
     *   1. ------ amount = lockedBalance[msg.sender]
     *   2. lockedBalance[msg.sender] = 0
     *   3. totalLocked -= amount
     *   4. safeTransfer ------ AIP
     *   5. ------ AipUnlocked ------
     * ------------------------------------------------------------------------------hasAppAccess / _getActiveReferrer ---------------
     * ------------AipUnlocked(msg.sender, amount)
     */
    function unlockAIP() external {
        uint256 amount = lockedBalance[msg.sender];
        if (amount == 0) revert NoLockedAIP(); // ---------

        lockedBalance[msg.sender] = 0; // ------------
        totalLocked -= amount; // ------------------------

