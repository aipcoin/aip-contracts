     *      ---WeeklyRankingSub.depositWeeklyPool / FinalePoolSub.depositFinalePool------------
     *      --------------------------------------------------------------------------------------------------- gas---
     *   3. ------ safeTransferFrom --- msg.sender --- AIP ------------------------------------ approve------
     *   4. --- poolType --------------------------------------------- emit ---------------------------------
     * ---------------
     *   - poolType==0---rewardPool += amount--------------------- currentRewardPerUser ---------
     *   - poolType==1---weeklyPool += amount---------------------------migrate ---------------------
     *   - poolType==2---finalePool += amount---------------------------migrate ---------------------
     * ------------
     *   - poolType==0---RewardPoolDeposited(msg.sender, amount, rewardPool)
     *   - poolType==1---WeeklyRankingPoolUpdated(weeklyPool, msg.sender, amount)
     *   - poolType==2---FinalePoolUpdated(finalePool, msg.sender, amount)
     * ------------
     *   - ------ OpenZeppelin SafeERC20.safeTransferFrom--------------------- revert---
     *   - ------------------------------------------------------------------------------------CEI ---------------------------------
     *     --------------------------------------------- rewardPool/weeklyPool/finalePool ---------------------------------------
     */
    function depositToPool(uint8 poolType, uint256 amount) external {
        _checkNotPaused(); // ------------------------------------------------------------------------------------------------------
        // --------------------- 1 AIP---------------------------------------------------------------------------------------
        if (amount < 1e18) revert ZeroAmount();
        // P2 ---------------------------------------------------------------------/------------ migrate ------------------
        // ------------------------------------------------------------------------------ AIP ------------------------------------
        // ---------"------------------------------------"------------------------------ withdrawTokens ------------
        // --------------------------------- revert --------------------------------------------------- migrate ---------
        // ------------------------------------------
        if (poolType == 1 && weeklySub != address(0)) revert PoolMigratedToSub(); // --------------------------- WeeklyRankingSub.depositWeeklyPool
        if (poolType == 2 && finaleSub != address(0)) revert PoolMigratedToSub(); // --------------------------- FinalePoolSub.depositFinalePool
        // ------------------ AIP --------------------------------------------- token.approve(---------, amount)
        // ------ safeTransferFrom ------ transferFrom------------------------ revert---------------------------
        token.safeTransferFrom(msg.sender, address(this), amount);
        // ------------------------------poolType ---------------------------------------
        if (poolType == 0) {
            // ------------------------ rewardPool---------------------------------------currentRewardPerUser ------------------------------ rewardPool ---------
            rewardPool += amount;
            // emit ------------------------contributor=------------amount=------------------newPoolAmount=--------- rewardPool ------
            emit RewardPoolDeposited(msg.sender, amount, rewardPool);
        } else if (poolType == 1) {
            // --------------------- migrate ------------------------------------ weeklyPool------------------------------------
            // migrate ------------------------ migratePoolsToSubs ------------------------------------------
            weeklyPool += amount;
            // ------------------------------newPoolAmount=------------------contributor=------------contribution=---------------
            emit WeeklyRankingPoolUpdated(weeklyPool, msg.sender, amount);
        } else if (poolType == 2) {
            // --------------------- migrate ------------------------------------ finalePool------------------------------------
            // migrate ------------------------ migratePoolsToSubs ------------------------------------------
            finalePool += amount;
            // ------------------------------newPoolAmount=------------------contributor=------------contribution=---------------
            emit FinalePoolUpdated(finalePool, msg.sender, amount);
        } else {
            // ------------------------------ 0/1/2------------------ revert------------------------------------------------
            revert InvalidPoolType();
        }
    }

    /**
     * setHoldThreshold --- ------ AIP ---------------holdThreshold------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------onlyOwner
     * ------------amount == 0---L1 --------------- 0 ------------------ _getActiveReferrer ---
     *        "lockedBalance >= holdThreshold" ------------------------------------------------
     *        "------"------------------------------------amount <= 500e18---500 AIP ---------
     * ---------------holdThreshold = amount
     * ------------HoldThresholdUpdated(oldThreshold, amount)
     * ------------------ hasAppAccess / _getActiveReferrer ------------------------
     */
    function setHoldThreshold(uint256 amount) external onlyOwner {
        if (amount == 0) revert ZeroAmount(); // L1---0 ---------------------------------------------
        if (amount > 500e18) revert UnlockAmountTooHigh(amount); // ------ 500 AIP
        uint256 oldThreshold = holdThreshold;
        holdThreshold = amount;
        emit HoldThresholdUpdated(oldThreshold, amount);
    }

    /**
     * withdrawTokens --- owner --------------- USDT ------------------ AIP
     * ----------------------------------------------------------------------------
     * --------------- owner------ OwnableUnauthorizedAccount ------------ onlyOwner ------------
     * ------------tokenType=0 ------ USDT---tokenType=1 ------ AIP------------ InvalidTokenType
     * ---tokenType=0 ---------
     *   - available = ownerUsdtFees--------- 1% --------------- + ------------ owner ------ + ---------------------------------
     *   - amount > available --- InsufficientAvailableUSDT
     *   - ------ ownerUsdtFees ------ USDT --- msg.sender--------- WithdrawnUSDT
     * ---tokenType=1 ---------
     *   - available = ------ AIP ------ - ------------------
     *     -- tokensInPool---------------------
     *     -- initialSaleRemaining------------------------
     *     -- stakingAllocation = rewardPool + weeklyPool + finalePool------------------
     *     -- totalPendingReferralRewards--------------- AIP---
     *     -- ownerReferralRewards--------- owner AIP---
     *     -- totalLocked--------------- AIP---
     *     -- backupTokensInPool--------- backup ------
     *   --- 1--------------------------- FloorPlanSub ------------------ AIP ------------------------------------------------
     *        --------------- available --------------------------------- floorPlanLockedAipTotal
     *   --- 2---------/------------------ WeeklyRankingSub / FinalePoolSub ------------weeklyPool/finalePool
     *        --------------------------------- migrate --------------- 0------------------ AIP ------------------------------
     *        ------------------------------------------------------------------------
     *   - amount > available --- InsufficientAvailableAIP
     *   - --------- AIP --- msg.sender------------------------------------------"------"------------------ WithdrawnAIP
     */
    function withdrawTokens(uint8 tokenType, uint256 amount) external {
        if (msg.sender != owner()) revert OwnableUnauthorizedAccount(msg.sender); // --- owner
        if (tokenType == 0) {
            // ------ USDT------------ ownerUsdtFees---1% --------- + ------------ owner ------ + ---------------------------
            uint256 available = ownerUsdtFees;
            if (amount > available) revert InsufficientAvailableUSDT(amount, available);
            ownerUsdtFees -= amount; // ------------------
            usdt.safeTransfer(msg.sender, amount);
            emit WithdrawnUSDT(msg.sender, amount);
        } else if (tokenType == 1) {
            // ------ AIP---------------"------"--------------------- - ------------/--------------------------- _availableAIP
            uint256 available = _availableAIP(token.balanceOf(address(this)));
            if (amount > available) revert InsufficientAvailableAIP(amount, available);
            token.safeTransfer(msg.sender, amount); // ---------------------------------
            emit WithdrawnAIP(msg.sender, amount);
        } else {
            revert InvalidTokenType(); // ------------
        }
    }

    /**
     * availableAIP --- --------------------------- owner --------------- AIP ------------------------
     * ----------------------------------------------------------------------------
     * ---------------------------FloorPlan--------------------------- AIP --------------------------- owner=------------
     *   ------------------------------ AIP ------------------------------------------"------------"------owner --- EOA
     *   --------------------------- withdrawTokens(1) ---------------------"---------------------------"------------
     *   ------------------------------------------------------------
     * --------------- withdrawTokens(1) --- available --------------------------- _availableAIP------
     *   ------ AIP ------ ------------------- + ------------ + ------------ + ------------ + owner ------
     *   + ------------ + backup --------------------------------- revert LedgerInconsistency---
     * ------------------FloorPlanSub.claimFloorPlan --------- 10000 AIP/------------------------------------------------
     */
    function availableAIP() external view returns (uint256) {
        return _availableAIP(token.balanceOf(address(this)));
    }

    /**
     * _availableAIP --- ------------ AIP ---------------withdrawTokens(1) --- availableAIP() ---------
     * ----------------------------------------------------------------------------
     * ------------balanceAip--------------------------- AIP ------------------------------------
     * ------------available = balanceAip - 7 ------------------
     *   mainPool.tokensInPool---------------------+ initialSaleRemaining------------------
     *   + rewardPool + weeklyPool + finalePool------------------------/------ migrate ------------ 0---
     *   + totalPendingReferralRewards------------------+ ownerReferralRewards---owner ---------
     *   + totalLocked------------------+ backupPool.tokensInPool--------- backup ------
     * --------------------------------- floorPlanLockedAipTotal------------------ AIP ------------ FloorPlanSub---
     *   ------------------------FloorPlan claim --------- AIP ---------------------------------------------------
     * ------------------balanceAip < ------------ --- revert LedgerInconsistency------ withdrawTokens
     *   --------------------------------------------------- uint256 ------ panic 0x11------
     */
    function _availableAIP(uint256 balanceAip) private view returns (uint256) {
        uint256 stakingAllocation = rewardPool + weeklyPool + finalePool; // ---------------rewardPool+weeklyPool+finalePool---
        uint256 totalDeductions = mainPool.tokensInPool + initialSaleRemaining + stakingAllocation + totalPendingReferralRewards + ownerReferralRewards + totalLocked + backupPool.tokensInPool; // ------------------
        if (balanceAip < totalDeductions) revert LedgerInconsistency(balanceAip, totalDeductions); // ------------ --- ------------
        return balanceAip - totalDeductions; // ---------------------------------------------------
    }

    // ============ Staking Pool Functions ============

    /**
     * _civilFromDays --- civil_from_days ---------------------------B1 ------------ _monthStartUTC ---
     * _monthIndexSinceEpoch ------------------------ --- ---------------
     * ----------------------------------------------------------------------------
     * --------------- Unix ------------------------------ (day, y, m, dom) ------------------------------------------
     *        ---------------------------------------Howard Hinnant ------------------/------------------
     *        ---------------------2/29------------------28/29/30/31 ---------
     * ------------
     *   - day = ts -- 86400------ 1970-01-01 ------------------------------------------------------
     *   - z = day + 719468--------------- 0000-03-01 ---------------3 ------------"---------"---------
     *   - era = z -- 146097---400 ------------------------ = 400--365 + 97 --------- = 146097 ------
     *   - doe = z mod 146097---400 ------------------------ [0, 146096]
     *   - yoe = (doe - doe--1460 + doe--36524 - doe--146096) -- 365--------------------- [0, 399]
     *     -----1460 ------"--- 4 ------"--------------36524 ------"--- 100 ------"--------------146096 ------"--- 400 ------"------------
     *   - doy = doe - (365--yoe + yoe--4 - yoe--100)------------------------3 ------------[0, 365]
     *   - mp = (5--doy + 2) -- 153---------------3 ---=0 --- ------ 2 ---=11---
     *   - dom = doy - (153--mp + 2) -- 5 + 1------------------ [1, 31]
     *   - y = yoe + era -- 400------------------3 --------------------- --- ------------ 1/2 ------------
     *   - m = mp < 10 ? mp + 3 : mp - 9--------------- [1, 12]------ m --- 2 --- y += 1---1/2 ------------------
     * ------------day=--- 1970-01-01 ---------------y=------------m=--------- [1,12]---dom=--------------- [1,31]
     */
    function _civilFromDays(uint256 ts)
        private pure returns (uint256 day, uint256 y, uint256 m, uint256 dom)
    {
        day = ts / 86400; // --- 1970-01-01 ------------
        uint256 z = day + 719468; // --- 0000-03-01 ------------------------------------
        uint256 era = z / 146097; // 400 ---------------
        uint256 doe = z - era * 146097; // 400 --------------------- [0, 146096]
        uint256 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; // --------------- [0, 399]
        uint256 doy = doe - (365 * yoe + yoe / 4 - yoe / 100); // ---------------3 ------------[0, 365]
        uint256 mp = (5 * doy + 2) / 153; // ------------3 ---=0 --- ------ 2 ---=11---
        dom = doy - (153 * mp + 2) / 5 + 1; // --------------- [1, 31]
        y = yoe + era * 400; // ---------------3 ------------------------
        m = mp < 10 ? mp + 3 : mp - 9; // ------------ [1, 12]
        if (m <= 2) {
            y += 1; // 1 ------2 ---------------------------
        }
    }

    /**
     * _monthStartUTC --- ------ Unix --------------- UTC ------------ 1 --- 0 ---------------------------
     * ----------------------------------------------------------------------------
     * --------------------- Unix --------------------------------- UTC --------------------------- 1 --- 00:00:00 UTC------
     *        ------------------/---------"------------------"------
     * ------------------ _civilFromDays ---------------B1 --------------------- = (day - (dom - 1)) -- 86400
     * ------------internal pure------------------------------ uint256 ---------------gas ---------------------------------
     */
    function _monthStartUTC(uint256 ts) internal pure returns (uint256) {
        (uint256 day, , , uint256 dom) = _civilFromDays(ts); // ------------------
        return (day - (dom - 1)) * 86400; // ------ 1 --- 00:00:00 UTC ---------
    }

    /**
     * _monthIndexSinceEpoch --- ------ Unix --------------- UTC ---------"---------"---------------
     * ----------------------------------------------------------------------------
     * ------------------ y--12 + (m-1)--------- 0 --- 1 --- = 0 --------- +1---------------------------------------------
     *        ------ Staked --------- periodIndex = --------------- - ------------------------
     * ------------------ _civilFromDays ---------------B1 ------------------ y/m ------
     * ------------internal pure------------------
     */
    function _monthIndexSinceEpoch(uint256 ts) internal pure returns (uint256) {
        (, uint256 y, uint256 m, ) = _civilFromDays(ts); // ------------------
        return y * 12 + (m - 1); // --------- 0 --- 1 ------------------
    }

    /**
     * _advancePeriod --- ------------------------ UTC ---------------------/--------------- 30 ---------------------
     * ----------------------------------------------------------------------------
     * --------------------- UTC ------------------------------------ 1 --- 0 --------- currentPeriodStart------
     *        ------------------------------------------ currentPeriodStart ------------------------
     * ---------------------------"------ 30 ---"---------------------------------------------------------
     *   - currentPeriodReward = rewardPool -- REWARD_BPS -- BPS---8% ---------------
     *   - currentRewardPerUser = (currentPeriodReward -- PRECISION -- SLOTS_PER_PERIOD) -- PRECISION
     *     ---600 ------------------------------ PRECISION ---------
     *   - --- currentRewardPerUser == 0 --- currentPeriodReward > 0---currentRewardPerUser = PRECISION--------- 1e18---
     *   - currentPeriodSlots = 0------------------------------------------------/---------
     *   - currentPeriodStart = ------ 1 --- 0 ---------------------------------------------------------------------
     *     ------------------------------ rewardPool ------------------------------------------------------------------------
     * ------------------------------ 30 ------------startTime + LOCK_PERIOD---------------------------------------------------
     *          ------------------ 30 --------------------------------------------------------- claim
     * ---------------stake / claimStakingRewards ------------------------------------------------------
     */
    function _advancePeriod() internal {
        uint256 monthStart = _monthStartUTC(block.timestamp); // ------ UTC --- 1 --- 0 ---
        if (monthStart <= currentPeriodStart) return; // ------------------------------------
        currentPeriodReward = rewardPool * REWARD_BPS / BPS; // ------------------8%---
        currentRewardPerUser = (currentPeriodReward / PRECISION / SLOTS_PER_PERIOD) * PRECISION; // ------------------600 ---------------
        if (currentRewardPerUser == 0 && currentPeriodReward > 0) { // ------ 1e18
            currentRewardPerUser = PRECISION;
        }
        currentPeriodSlots = 0; // ------------------
        currentPeriodStart = monthStart; // ------------------------
    }

    /**
     * stake --- ---------------------7 --------- + backup ------------------
     * ----------------------------------------------------------------------------
     * ------------------------ 7 -- currentRewardPerUser --- AIP--------- backup ------------30 ---------------------
     * ------------
     *   - appAccess[msg.sender][STAKING_APP_ID]---NoAppAccess---
     *   - !stakes[msg.sender].active---AlreadyStaking---
     *   - currentPeriodSlots < SLOTS_PER_PERIOD---PeriodFull---600 ---------
     *   - rewardPool >= currentRewardPerUser---RewardPoolExhausted---
     *   - stakeAmt != 0---ZeroStakeAmount---
     * ------------
     *   1. _advancePeriod ------------
     *   2. stakeAmt = currentRewardPerUser -- 7---7 ------------
     *   3. --------------- stakeAmt AIP
     *   4. totalBackupTokens = stakeAmt + currentRewardPerUser--------- + --------------- backup ------
     *   5. --- backupTokensInPool ------------ newBackupShares------------------
     *   6. ------ totalBackupShares / backupTokensInPool--------- backupUsdtDebt
     *   7. ------ stakes[msg.sender]---amount/startTime/active/backupShares/backupUsdtDebt/backupShareEpoch---
     *   8. currentPeriodSlots++---rewardPool -= currentRewardPerUser---pendingRewards += currentRewardPerUser
     *   9. ------ Staked ------
     * ------------Staked(msg.sender, stakeAmt, periodIndex)
     */
    function stake() external {
        _checkNotPaused(); // ------------------------------------------------------------------------------------ claim ---------------
        if (!appAccess[msg.sender][STAKING_APP_ID]) revert NoAppAccess(); // ---------------------
        if (stakes[msg.sender].active) revert AlreadyStaking(); // ------------------

        _advancePeriod(); // --------------------------- currentRewardPerUser---

        if (currentPeriodSlots >= SLOTS_PER_PERIOD) revert PeriodFull(); // ---------------600---
        if (rewardPool < currentRewardPerUser) revert RewardPoolExhausted(); // ------------

        uint256 stakeAmt = currentRewardPerUser * 7; // 7 ---------
        if (stakeAmt == 0) revert ZeroStakeAmount(); // ------

        token.safeTransferFrom(msg.sender, address(this), stakeAmt); // --------- AIP

        uint256 totalBackupTokens = stakeAmt + currentRewardPerUser; // ------ + --------- backup ---

        // --------------------------------------------- _advanceEpochIfDust------backup ------------------
        // --- POOL_DUST_THRESHOLD ------------------------ + ---------------------------------
        // ---------"backup ------------ 1 wei ---------"------------------------------------------------------
        _advanceEpochIfDust(backupPool, false); // backup ------------ PoolEpochAdvanced ------------------------------

        // ------------------------ U2 --------------------- deposit()/_addConsumedToPool ------
        // _mintPoolShares---Phase-2 ---------U2 ---------------------------------------
        // ------------------U3.4---------------"--- ns"------"1e60 ------/--- stakes"---------------------
        //   backupPool.epoch ------------------------------------------ backupShareEpoch ------------
        //   --------- stakes --------------------------- backupPool.epoch---------------------
        uint256 newBackupShares = _mintPoolShares(backupPool, totalBackupTokens, 11); // anchorTrigger=11 backup ------
        // ------------------------ deposit() ---------SHARE_SATURATION_CAP---------------------------------------------------
        // ---U2 --------------------------- 1e60 ---------------------------------------------------------
        if (backupPool.totalShares + newBackupShares > SHARE_SATURATION_CAP) revert ShareSaturation();

        backupPool.totalShares += newBackupShares; // backup ---------------
        backupPool.tokensInPool += totalBackupTokens; // backup --- AIP ------
        uint256 backupUsdtDebt = Math.mulDiv(newBackupShares, backupPool.usdtPerShare, PRECISION); // ------------ USDT ---------mulDiv ---------------------

        stakes[msg.sender] = StakeInfo({ // ------------------
            amount: stakeAmt,
            startTime: block.timestamp,
            active: true,
            backupShares: newBackupShares,
            backupUsdtDebt: backupUsdtDebt,
            backupShareEpoch: backupPool.epoch // ------------------------ backup ------------------
            // --------- backup --------------------------- +1------------------ claim ---------"------------------------------"---
            // --------------------------------- USDT---AIP --------- 0---------------------------/---------------/---------/------------
        });

        currentPeriodSlots++; // ------------ +1
        rewardPool -= currentRewardPerUser; // ------------
        pendingRewards[msg.sender] += currentRewardPerUser; // ------------------

        emit Staked(msg.sender, stakeAmt, _monthIndexSinceEpoch(block.timestamp) - _monthIndexSinceEpoch(STAKING_MONTH_ANCHOR)); // periodIndex = --------------------- = 0--------- +1------------------------
    }

    /**
     * claim --- ---------------------------30 ------------------------------------
     * ----------------------------------------------------------------------------
     * ---------------------------------backup --------------- AIP---+ ------ USDT
     * ------------
     *   - stakes[msg.sender].active---NoActiveStake---
     *   - block.timestamp >= info.startTime + LOCK_PERIOD---StakeNotMature---30 ---------------
     * ------------
     *   1. _advancePeriod ------------
     *   2. ------------------------------------------------------ _migrateAcrossEpochs ------------------------
     *      -- ---------------------info.backupShareEpoch == backupShareEpoch------------------------------
     *        effectiveTokens = shares -- backupTokensInPool -- totalBackupShares--------------- 0------
     *        usdtEarned = shares -- backupUsdtPerShare -- PRECISION --- debt---
     *      -- ---------------------info.backupShareEpoch < backupShareEpoch---------------------------
     *        ---------/------------3.6 + C1 ------------
     *        - --------------------- num==0/den==0---------------------------------------------------------------
     *          ------------AIP ------------------------ USDT --- effectiveTokens = 0---------------------
     *          USDT = ------------------ +------------------------------------------------------------------------
     *          --------------------------------- run==0 ------ break------------------ 0---
     *        - --------------------- num>0 --- den>0------------------------------------------------------------
     *          USDT = ------------------ + ----------------------- +--------------------- --- ------
     *          backupUsdtPerShare ------------------C1 ------------------------------------------------
     *          backupUsdtPerShare ------------------------------
     *          effectiveTokens = --------------- -- backupTokensInPool -- totalBackupShares
     *          ------------------------ AIP------------------------------------
     *   3. ------ stakes[msg.sender]---active/amount------pendingRewards[msg.sender] = 0
     *   4. ------/---------------------------------------------------------
     *      -- ------------------------------------------totalBackupShares -= shares---
     *        backupTokensInPool -= effectiveTokens------
     *      -- --------------------------------------------------------------------------- totalBackupShares ---
     *        --------------------- 0 --- ------------ revert------------------effectiveTokens --- 0 ------------------
     *      -- --------------------------------- run>0 ---------------------------------------------------------------
     *        --------- totalBackupShares ---------------------------------------------------------------------
     *        ------------------------
     *   5. --- AIP---effectiveTokens------ USDT---usdtEarned------------
     *   6. ------ Claimed ------
     * ------------------------------------ backupUsdtPerShare ---------------_sellBackupTokens ------ +=------
     *   --------- backupUsdtDebt ------------------------------------ perShare ---------------------------------------
     *   "shares -- --------- -- PRECISION --- debt"------------USDT ------------------------------------
     *   ---uPS ------------ --- ------------------"------ uPS --- ------------------"--- --- 0------------
     * ------------Claimed(msg.sender, 0, effectiveTokens, usdtEarned)------------------ 0 ------------------
     */
    function claim() external {
        StakeInfo storage info = stakes[msg.sender];
        if (!info.active) revert NoActiveStake(); // ---------------
        if (block.timestamp < info.startTime + LOCK_PERIOD) revert StakeNotMature(); // ------ 30 ------------

        _advancePeriod(); // ------------

        uint256 effectiveTokens;
        uint256 usdtEarned;
        if (info.backupShareEpoch < backupPool.epoch) {
            // ------------------------------------------------------/--------------- getStakingFullInfo / ------
            // _syncCustodianEpoch / getCustodianInfo ------ _walkEpochChain ------------------
            // Phase-2 ------------------/backup ---------------------------------------------------
            // ------ run=------------------------usdtEarned=------------------ + ------------------------
            // lastSnap=---------------------------------------------------------------------------------------
            // --- _walkEpochChain ------------------
            uint256 run;
            uint256 lastSnap;
            (run, usdtEarned, lastSnap) =
                _walkEpochChain(backupPool, info.backupShares, info.backupUsdtDebt, info.backupShareEpoch);
            if (run > 0) {
                // ===== ------------------------------------------------claim --------- =====
                // --- ------"------------------ --- ------"------------C1 ------------
                //    backupPool.usdtPerShare ------ --- --------- --- ------------------------------
                //    ------------------------------ backupPool.usdtPerShare ------------------------------C1 ---------
                usdtEarned += Math.mulDiv(run, backupPool.usdtPerShare - lastSnap, PRECISION);
                // --- --------------------- AIP------------------------------------------------------
                effectiveTokens = Math.mulDiv(run, backupPool.tokensInPool, backupPool.totalShares);
                // --- ---------------------------------------------------------------------------------
                // ------------------------------------------------ backupPool.totalShares ---------------------------
                // --------------------------------------------------------- -------- = ---------------------------
                // backupPool.tokensInPool --- AIP ---------------------------
                backupPool.totalShares -= run;
                backupPool.tokensInPool -= effectiveTokens;
            }
            // run == 0------------------------------------------ USDT------------ AIP------------------------------------------
            // --- backupPool.totalShares ------------------------------------------------effectiveTokens ------ 0---
            // --------------------------------- backupPool.tokensInPool
        } else {
            // ------------------------------------------ AIP------------------backupPool.totalShares == 0 ------ 0---
            effectiveTokens = backupPool.totalShares == 0 ? 0 : Math.mulDiv(info.backupShares, backupPool.tokensInPool, backupPool.totalShares); // mulDiv ------------------
            // USDT --------------------- perShare ---------------------------------------------------------------
            usdtEarned = Math.mulDiv(info.backupShares, backupPool.usdtPerShare, PRECISION) - info.backupUsdtDebt; // mulDiv ------------------
        }

        info.active = false; // ---------------
        info.amount = 0; // ------------------
        pendingRewards[msg.sender] = 0; // ------------------

        // ------/---------------------------------------------------------"------------------"------------
        //   -- ---------------------------------------------------------------totalBackupShares -= info.backupShares---
        //     backupTokensInPool -= effectiveTokens------------------------------------
        //   -- --------------------------------------------------------------------------- totalBackupShares ------------
        //     --------------- 0 ------------------ revert------------------------------------------effectiveTokens
        //     ------ 0------------------------------------ backupTokensInPool------------------
        //   -- ------------------------------------------ run>0 ---------------------------------------------------------
        //     --------------- totalBackupShares ---------------------------------------------------------------------
        //     ------------------------------------
        //   ------------------------------------------------totalBackupShares ------------------------------------
        //   ---------------backupTokensInPool ------------------------ AIP------------------------/---------
        if (info.backupShareEpoch == backupPool.epoch) {
            backupPool.totalShares -= info.backupShares; // backup ---------------
            backupPool.tokensInPool -= effectiveTokens; // backup --- AIP ------
        }

        if (effectiveTokens > 0) { // --- AIP ------
            token.safeTransfer(msg.sender, effectiveTokens);
        }
        if (usdtEarned > 0) { // --- USDT ------
            usdt.safeTransfer(msg.sender, usdtEarned);
        }

        emit Claimed(msg.sender, 0, effectiveTokens, usdtEarned);
    }

    /**
     * _sellBackupTokens --- backup ------------------ AIP--------------------- _executePoolPurchase ---------
     * ----------------------------------------------------------------------------
     * --------------- backup ------ AIP ------------------------ USDT ------ backup ------------------ backup ---------------
     * ------------aipAmount=--------- AIP ---------usdtAmount=------ USDT --------------- 1% ---------------------
     * ------------backupTokensInPool >= aipAmount---InsufficientBackupSupply---
     * ------------
     *   1. backupUsdtPerShare += usdtAmount -- PRECISION -- totalBackupShares------------ USDT ---------
     *   2. backupTokensInPool -= aipAmount
     *   3. --- backupTokensInPool == 0---------------------------------"------------"------------------
     *      --- epochEndPerShare[backupShareEpoch] = backupUsdtPerShare--------------------------------------- USDT---
     *        --------------------------------------------------------- 1 ------------------------
     *      --- backupShareEpoch++--------- +1------------------------------------------------------------------------------
     *      --- totalBackupShares = 0--------------------------------------------------------- USDT ------------
     *        claim ------------------------------------------ AIP/------------------------------/---------/------------
     *   4. ------ BackupTokensSold ------
     * ---------------backupUsdtPerShare --------------------------------------------------------------- + ------------
     * ------------BackupTokensSold(aipAmount, usdtAmount)
     */
    function _sellBackupTokens(uint256 aipAmount, uint256 usdtAmount) internal {
        if (backupPool.tokensInPool < aipAmount) revert InsufficientBackupSupply(); // backup ---------

        // ------------------------------------ _accumulateUsdt---------------------------------
        // backupPool.usdtPerShare += usdtAmount -- PRECISION -- totalShares ---------------
        // totalShares ------------------------ 0---------------------------------------
        _accumulateUsdt(backupPool, usdtAmount);

        backupPool.tokensInPool -= aipAmount; // backup --- AIP ------
        // ------/------------------------ --- epoch+1 --- ---------------Phase-2 --------- _advanceEpochIfDust---
        // backup ------------ PoolEpochAdvanced --------------------------------------- (0,1) ------------
        // ------------------------mapping ------ (0,0) ---------------------------
        _advanceEpochIfDust(backupPool, false);

        emit BackupTokensSold(aipAmount, usdtAmount);
    }

    // ------------ _advanceBackupEpochIfDust---backup ------------------------------ Phase-2 ------------
    //       _advanceEpochIfDust(backupPool, false)---------------------------------------"------------"---
    //       ---------------1 wei ------------------ --- ------------------ --- ------------------ POOL_DUST_THRESHOLD
    //       ------------ _advanceEpochIfDust ------------------

    /**
     * _initializeRewardPool --- ------------------------------------ setStakingPoolAllocation ---------
     * ----------------------------------------------------------------------------
     * ------------------ amount ------ AIP --- rewardPool--------------------- currentRewardPerUser
     * ------------amount=--------- AIP ---------9,000,000e18---
     * ------------
     *   1. rewardPool += amount
     *   2. currentPeriodReward = rewardPool -- REWARD_BPS -- BPS---8%---
     *   3. currentRewardPerUser = (currentPeriodReward -- PRECISION -- SLOTS_PER_PERIOD) -- PRECISION
     *   4. --- currentRewardPerUser == 0 --- currentPeriodReward > 0---currentRewardPerUser = PRECISION------------
     *   5. ------ RewardPoolInitialized ------
     * ------------RewardPoolInitialized(amount)
     */
    function _initializeRewardPool(uint256 amount) internal {
        rewardPool += amount; // ------------
        currentPeriodReward = rewardPool * REWARD_BPS / BPS; // ---------------------8%---
        currentRewardPerUser = (currentPeriodReward / PRECISION / SLOTS_PER_PERIOD) * PRECISION; // ---------------
        if (currentRewardPerUser == 0 && currentPeriodReward > 0) { // ------ 1e18
            currentRewardPerUser = PRECISION;
        }

        emit RewardPoolInitialized(amount);
    }

    /**
     * getStakingFullInfo --- ---------------------------15 ---------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------backup ---------------------------------------
     * ------------account=------------
     * ------------
     *   - _isActive---stakes[account].active------------------------
     *   - _amount---stakes[account].amount--------- AIP ---------
     *   - _startTime---stakes[account].startTime---------------------------
     *   - _pendingReward---pendingRewards[account]------------------
     *   - _maturityTime---startTime + LOCK_PERIOD---------------------
     *   - _effectiveTokens--------- AIP--------------------- claim ------------------------------
     *       -- ---------------------backupShareEpoch < ---------------------------------------------------------
     *         ---num==0/den==0--------- 0---------------------------------------------------------------------
     *         ------------------ -- backupTokensInPool -- totalBackupShares---------------------------------
     *       -- ------------------------ backup --------------------------------- 0---
     *   - _usdtEarned---USDT --------------------------- claim ------------------------------
     *       -- --------------------------------------------------------------- +---------------------------------------
     *         --------------- +--------------------------------------- --- ------ backupUsdtPerShare ---------
     *         ---C1 ------------------------ backupUsdtPerShare ------------------------
     *       -- ------------------------------------ backupUsdtPerShare ------
     *   - _rewardPool---rewardPool--------- AIP ---------
     *   - _currentPeriodSlots---currentPeriodSlots---------------------------
     *   - _currentRewardPerUser---currentRewardPerUser---------------------
     *   - _currentPeriodReward---currentPeriodReward------------------------
     *   - _currentPeriodStart---currentPeriodStart------------------------------
     *   - _backupTokensInPool---backupTokensInPool---backup --- AIP ---------
     *   - _backupUsdtPerShare---backupUsdtPerShare---backup --------- USDT---
     *   - _effectiveRemainingSlots------------------------min(------------, ---------------------)---
     */
    function getStakingFullInfo(address account) external view returns (
        bool _isActive,
        uint256 _amount,
        uint256 _startTime,
        uint256 _pendingReward,
        uint256 _maturityTime,
        uint256 _effectiveTokens,
        uint256 _usdtEarned,
        uint256 _rewardPool,
        uint256 _currentPeriodSlots,
        uint256 _currentRewardPerUser,
        uint256 _currentPeriodReward,
        uint256 _currentPeriodStart,
        uint256 _backupTokensInPool,
        uint256 _backupUsdtPerShare,
        uint256 _effectiveRemainingSlots
    ) {
        StakeInfo storage info = stakes[account];
        // --------------------------------------- claim() ------------------------------------------------ = ------------------
        // ------------------ --- --------------------------------------------- --- --- claim() / ------
        // _syncCustodianEpoch / getCustodianInfo ------ _walkEpochChain---Phase-2 ---------
        // ---------/backup ------------------------------------------------------------------------------------------
        // --------- AIP ------ 0------------+------------------------------ AIP ------------------------USDT ---
        // "------------------ --- ------"---------------C1 ---------------------------------------------
        // ------------------------ claim ------------------totalShares/tokensInPool---------------
        uint256 effTokens;
        uint256 earned;
        if (info.active) {
            if (info.backupShareEpoch < backupPool.epoch) {
                // --------------------------------------------- claim() ------------------------------
                // ------------------------"------------------ --- ------"------------C1 ------------------------
                // ------------------ AIP---run>0 ------ totalShares>0------------ claim()---
                uint256 run;
                uint256 lastSnap;
                (run, earned, lastSnap) =
                    _walkEpochChain(backupPool, info.backupShares, info.backupUsdtDebt, info.backupShareEpoch);
                if (run > 0) {
                    earned += Math.mulDiv(run, backupPool.usdtPerShare - lastSnap, PRECISION);
                    effTokens = Math.mulDiv(run, backupPool.tokensInPool, backupPool.totalShares);
                }
                // run == 0------------------------------------------ USDT------------ AIP------ claim() ---------------
            } else {
                // ------------------------------------------ AIP------------------
                effTokens = backupPool.totalShares == 0 ? 0 : Math.mulDiv(info.backupShares, backupPool.tokensInPool, backupPool.totalShares); // mulDiv ------------------
                earned = Math.mulDiv(info.backupShares, backupPool.usdtPerShare, PRECISION) - info.backupUsdtDebt; // mulDiv ------------------
            }
        }
        uint256 remainingSlots = 0;
        if (currentRewardPerUser > 0) { // ------------------------
            uint256 slotsFromPeriod = SLOTS_PER_PERIOD - currentPeriodSlots; // ------------------
            uint256 slotsFromPool = rewardPool / currentRewardPerUser; // ---------------------
            remainingSlots = slotsFromPeriod < slotsFromPool ? slotsFromPeriod : slotsFromPool; // ------------
        }
        return (
            info.active,
            info.amount,
            info.startTime,
            pendingRewards[account],
            info.startTime + LOCK_PERIOD,
            effTokens,
            earned,
            rewardPool,
            currentPeriodSlots,
            currentRewardPerUser,
            currentPeriodReward,
            currentPeriodStart,
            backupPool.tokensInPool,
            backupPool.usdtPerShare,
            remainingSlots
        );
    }

    // ============ --------------------------------------------- Floor Plan Functions --------- ============
    // --------------------------------------------- FloorPlanSub ------------contracts/contracts/FloorPlanSub.sol------
    //       ------------------ 7 ------------lockFloorPlan/unlockFloorPlan/claimFloorPlan/manageFloorPlanUsdt/
    //       getFloorPlanFullInfo/getFloorPlanPoolStats/_hasUnlockedFloorPlanApp---------------------------------
