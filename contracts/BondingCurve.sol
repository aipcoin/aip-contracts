    /**
     * getCustodianInfo --- ------------------custodian------------------------------------ USDT
     * ----------------------------------------------------------------------------
     * ------------------------------------ AIP ------------------------------ USDT---Q3 ------------------ = ------------------
     * ------------addr=---------------
     * ------------
     *   - _effectiveBalance--------------- AIP--------------------- = shares -- tokensInPool -- totalShares---
     *     --------------- = --------------------- -- tokensInPool -- totalShares------------------------------
     *   - _custodianShares------------------------------------ = custodianShares[addr]------------------------
     *     --------------- = ------------------------------------------------------------------------------------
     *     ------------------------------Q3 ------------------------------------------------------
     *   - _pendingUsdt--------- USDT = ------------------------------------------------------------
     *     custodianPendingUsdt---+ custodianPendingUsdt[addr] + ---------------------------------------
     * ---U6 ------------------------------------------"---------------------------"---------------perShareForValuation------
     *   --- _custodianShares ------------------------------------------------------------------------------------ ---
     *   ------------------------------ _migrateAcrossEpochs --------------------- _syncCustodianEpoch ------
     *   ---------------------------------------------------------------------------------------
     */
    function getCustodianInfo(address addr) external view returns (
        uint256 _effectiveBalance,
        uint256 _custodianShares,
        uint256 _pendingUsdt
    ) {
        uint256 effBalance;
        uint256 shares = custodianShares[addr]; // ---------------------------------
        uint256 pending; // ------ USDT---------------------------------------------------------------------
        if (custodianEpoch[addr] == mainPool.epoch) {
            // ===== ---------------------------------------------------------=====
            if (mainPool.totalShares != 0) { // ---------------------------------------
                effBalance = Math.mulDiv(shares, mainPool.tokensInPool, mainPool.totalShares); // --------------------------- AIP---mulDiv ------------------ panic ---------------
            }
            // ------ = --------------- perShare ------------ --- ------------ + ------------------B2 ---------------
            pending = _accruedUsdt(shares, custodianUsdtDebt[addr]) + custodianPendingUsdt[addr];
            return (effBalance, shares, pending);
        }
        // ===== ------------------------------------------------------------------------------ =====
        // ---Q3 ------------------------------------------------------------------------------------------------------
        // ------------------"--------------- == ------------------------"------------------------------
        // _syncCustodianEpoch ------------ _walkEpochChain ---------------------------------------
        // --------------------------------------- deposit/withdrawAll/claimUsdt ------------------------------
        // ---------------------------------------settled ------------ custodianPendingUsdt---------------
        // newShares--------------------- newDebt---------------------------------------------------/------
        // ------------------------------------
        // ------------------uPS ------------ --- mulDiv(newShares, uPS) --- mulDiv(newShares, ------------
        // ------) = newDebt---------------------newShares==0--------------------------------- 0---------------------------------------
        (uint256 newShares, uint256 settled, uint256 lastSnap) = _walkEpochChain(mainPool, shares, custodianUsdtDebt[addr], custodianEpoch[addr]);
        // --------------- = --------- -----------------------------C1 ------------------------ _walkEpochChain---
        uint256 newDebt = Math.mulDiv(newShares, lastSnap, PRECISION);
        if (mainPool.totalShares != 0 && newShares != 0) {
            // ------------------------------------------------ AIP------------------------------------------------
            effBalance = Math.mulDiv(newShares, mainPool.tokensInPool, mainPool.totalShares);
        }
        // ------ = --------------------------------------- custodianPendingUsdt---------------------
        //        + --------------------- + ------------------------------------------------
        //        ------------ -- ------ uPS --- ------------------------------------------------------------
        //        ------------------------------------C1 ------------------
        // ------------------uPS ------------ --- mulDiv(newShares, uPS) --- mulDiv(newShares, ------------------)
        //        = newDebt---------------------newShares==0--------------------------------- 0---
        pending = settled + custodianPendingUsdt[addr]
            + (newShares == 0 ? 0 : Math.mulDiv(newShares, mainPool.usdtPerShare, PRECISION) - newDebt);
        return (effBalance, newShares, pending);
    }

