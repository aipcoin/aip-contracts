// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24; // Solidity ---------0.8.24 ------------------------------------------------------------------------

// ------ OpenZeppelin --- Ownable--------- owner ------------------------------------------
import "@openzeppelin/contracts/access/Ownable.sol";
// ------ ERC20 --------------------------- aip ------------
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
// ------ SafeERC20 ------------------------ transfer/transferFrom------------------------------------
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";

/**
 * IFinalePoolMainView --- ------------BondingCurve---------------------------
 * ----------------------------------------------------------------------------
 * ------------------------------"FinalePool"------------------------------------------------------------
 *   --------------- WeeklyRankingSub --------------------- import------------------------------------
 *   FloorPlanSub --------------------------- IFinalePoolMainView------------------------------------------------------
 * --------------------------------------------------------------------------------------------- 2 ------------------ view------
 *   1. getTotalUsdtVolume------------------------ USDT ------------------------ 7------------------------------------
 *      ------ 3,000 USDT ------------------------/------------------
 *   2. hasAppAccessById--------------------------------------------------- FINALE_POOL_APP_ID---finalePool------
 *      ------------------------------------------------------------------------------------------------
 * ------------------------------------------------------------------------------------------------------------------------------
 * ------------main --- immutable---------------------------------------------------------------------------------
 */
interface IFinalePoolMainView {
    // ------------ USDT --------------------- slot 7------------------------------------------------------------
    function getTotalUsdtVolume() external view returns (uint256);
    // ---------------------user --------------- appId ---------------true = ------------------------
    function hasAppAccessById(address user, bytes32 appId) external view returns (bool);
}

// ------------------------------ Ownable---------------------------------------------------------------
contract FinalePoolSub is Ownable {
    // --- SafeERC20 ------------ IERC20 ------------ IERC20 --------------- .safeTransfer/.safeTransferFrom------------------------
    using SafeERC20 for IERC20;

    // ======================= ---------------Finale Pool--------------------------------------------------------------- =======================
    // ------------ App ID---keccak256("finalePool")---------------------------------------------------------
    bytes32 private constant FINALE_POOL_APP_ID = keccak256("finalePool");
    // --------------------------------------------- 12 ------------------------------
    uint256 private constant FINALE_POOL_COOLDOWN = 12 hours;
    // ---------------------10000 AIP
    uint256 private constant FINALE_POOL_MAX_REWARD = 10_000e18;
    // ------------------------------------------------ 3,000 USDT ------------------------------------------------------------
    uint256 public constant FINALE_POOL_VOLUME_THRESHOLD = 3_000e18;

    // ======================= ------------------immutable--------------------------------------------------------------- =======================
    // AIP ------------------------------------------------------------------------
    IERC20 public immutable aip;
    // ------------BondingCurve------------------------------------------------------------------------ onlyMain ---------------
    IFinalePoolMainView public immutable main;

    // ======================= ------------------------------------------ slot 1 ------------ =======================
    // --------------- 4 ------------ BondingCurve ------------------------------------------ 70-73--------- finalePool
    //       ------------------------------------ migrate ---------------------------------------------------------------------------
    //       --- Ownable._owner --- slot 0------------------ slot 1 ------------------------------------------------------
    // ------------------ AIP--------------------- migrate --------------- 500,000 AIP
    uint256 private finalePool;
    // ---------------------------------------------------------------
    address private lastPoolTrader;
    // ------------------------------------
    uint256 private lastPoolTradeTime;
    // ---------------------------------------------------0 --------------------------------------- 0 ------------
    uint256 private lastFinaleClaimTime;

    // ======================= ------------------------------------------ =======================
    // --------------------------------------------------------------------- slot 5--------------- 0-4 ------------------
    //   hardhat_setStorageAt ---------------------------------------------------
    //   true = ------------------------------------------------depositFinalePool---------------
    //   ---------claimFinaleReward------------------------------------------------------------------------------------
    //   ------------ setPaused ---------------onlyMain------------------------ pause ---------
    //   ------------------------------------------------------------------"------------------------------"------------------
    bool private paused; // ------ 5---bool ------------------------ setPaused ---------------

    // ======================= ------------------------------------------------------------ =======================
    // ------------------------------ depositFinalePool------------------------------------------------------
    // setStakingPoolAllocation------------------------ depositToPool ---------------------------------
    event FinalePoolUpdated(uint256 newPoolAmount, address contributor, uint256 contribution);
    // ------------------------------------ claimFinaleReward---winner=------------amount=---------hoursSinceLastClaim=------------------------
    event FinaleRewardClaimed(address indexed winner, uint256 amount, uint256 hoursSinceLastClaim);
    // ======================= --------------------------------------------------------- =======================
    // ------------------------------------ setPaused------------ pause/unpause ------------------
    //   paused=------------------by=------------------------------------onlyMain ---------
    event SubPausedChanged(bool paused, address indexed by);
    // ------------------------------ migrateOut---owner ------------ forwardSubCall ---------------
    //   to=---------------------------------------------amount=--------------------- AIP ------
    event MigratedOut(address indexed to, uint256 amount);

    // ======================= ------ error---------------------------------revert --------------- =======================
    // ---------------------------------claimFinaleReward --- msg.sender != lastPoolTrader
    error NotFinaleWinner();
    // ------------------------------------------------------ 12 ------
    error FinaleCooldownNotElapsed();
    // ------------------------------------------------ < FINALE_POOL_VOLUME_THRESHOLD
    error FinalePoolNotActivated();
    // ------------------lastPoolTrader == address(0)--------------------------------------- error------------------
    error NoPendingRankingReward();
    // --------------------------------------- error--------------- FINALE_POOL_APP_ID --------------------------------------- false---
    error RankingAccessDenied();
    // --------- 0---depositFinalePool --------- < 1 AIP ------------------------ depositToPool ------------
    error ZeroAmount();
    // ---------------------------AIP/------------------------ address(0) ------------------------------
    error ZeroAddress();
    // ---------------------onPoolPurchase / receivePoolFunding ---------------------------------------------
    error OnlyMain();
    // ======================= ------------------ error =======================
    // ------------------------------------------------------------------------------------------------------------
    error ContractPaused();

    /**
     * --------- onlyMain --- ---------------------
     * ----------------------------------------------------------------------------
     * ------------onPoolPurchase--------------------- receivePoolFunding---migrate ------------------
     *   ------------------------------------------------------------------------------ 0.5M ---------------------------------
     *   ------------------------------------"------------------"------------------------------------------------------------
     * ------------msg.sender --------------------------------- main --------------- revert OnlyMain---
     */
    modifier onlyMain() {
        if (msg.sender != address(main)) revert OnlyMain(); // ------------
        _;
    }

    /**
     * --------------------- AIP / ------------------------ owner
     * ----------------------------------------------------------------------------
     * ---------------------------------------------------------------------------------------owner = ---------
     * ------------Ownable(msg.sender)--------------- owner------------------------------------ EOA ---------
     *         ------------ owner ------------ owner --------------------- FloorPlanSub ------------
     * ------------_aip=AIP ---------------_main=BondingCurve ---------------
     * --------------------------- address(0) --- revert ZeroAddress------------------------------------------
     */
    constructor(address _aip, address _main) Ownable(msg.sender) {
        if (_aip == address(0)) revert ZeroAddress(); // AIP --------- 0
        if (_main == address(0)) revert ZeroAddress(); // ------------------ 0
        aip = IERC20(_aip); // ------ AIP ---------immutable---
        main = IFinalePoolMainView(_main); // ------------------------------------immutable---
    }

    // ======================= ------------------------onlyMain--- =======================

    /**
     * onPoolPurchase --- ---------------------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------------- buyFromPool ------------------------------------------------ USDT/--- AIP/------
     *   totalUsdtVolume ------------------------------------------------------------------------------------
     *     if (totalUsdtVolume >= FINALE_POOL_VOLUME_THRESHOLD) {
     *         lastPoolTrader = msg.sender;      // ---------------------------------------------------------
     *         lastPoolTradeTime = block.timestamp; // ------------------
     *     }
     *   ------------------------------------------------------------------ totalUsdtVolume += usdtCost---
     *   ---------------------------------------------------------------------------------------"---------"---------------
     * ---------------------------onlyMain------------------------------------------------------"------------------"
     * ------------user=------------------------ msg.sender---
     * --------------------------------------------------- migrate ---------------------------
     */
    function onPoolPurchase(address user) external onlyMain {
        // ------------------------------------------ --- 3,000 USDT ---------------------------------------------------------------
        if (IFinalePoolMainView(main).getTotalUsdtVolume() >= FINALE_POOL_VOLUME_THRESHOLD) {
            lastPoolTrader = user; // ---------------------------------------------------------
            lastPoolTradeTime = block.timestamp; // ------------------
        }
    }

    /**
     * receivePoolFunding --- ------------------------------migrate ---------
     * ----------------------------------------------------------------------------
     * --------------------- migratePoolsToSubs ------ AIP safeTransfer ------------------------------------
     *   ------------------------------------------finalePool += amount------------------------------------------------
     *   ---------------------"------------------"---"------------------"---
     * ---------------------------onlyMain------0.5M ------------------------------------------
     * ------------amount=--------------- AIP ---------migrate ------ finalePool --------------- 500,000 AIP---
     * ------------------AIP ------------------------------------------------------------------------------
     */
    function receivePoolFunding(uint256 amount) external onlyMain {
        finalePool += amount; // ---------------------------AIP ---------------------------
    }

    // ======================= --------------------------------------------------- =======================

    /**
     * setPaused --- ---------------------------------------------------
     * ----------------------------------------------------------------------------
     * --------------------- pause()/unpause() ------------------------------------------------------------
     *   ------------------------ + ------ + ------ + ---------------------------------------------------------------
     * ---------------------------onlyMain--------------------- onlyOwner--------------------------- owner ---
     *   ------------------------ owner ------------------------------------------------------------ main
     *   ---immutable ------------------------------------
     * ------------------------------------ pause ---------------------------------------------------
     * ------------_paused=true ------------------------/ false ------------------------
     * ------------SubPausedChanged(_paused, msg.sender)
     */
    function setPaused(bool _paused) external onlyMain {
        paused = _paused; // ------------------------
        emit SubPausedChanged(_paused, msg.sender); // ---------------by=------------------
    }

    /**
     * migrateOut --- --------------------------------------- AIP ------------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------ bug --------------------------------------------------------- AIP
     *   --------------------------------------------------------------------------- owner ---------------------
     * --------------- owner---onlyOwner------------------------------ owner=------------------------------------
     *   --- owner ------------ forwardSubCall --------------------------------- EOA ---------------
     * ------------------AIP--------------------------- --- to---------------------------------------------------------------
     * ------------------finalePool --- 0--------------------------- view ---------------------------------
     *   ---------------------------------------------------------------lastPoolTrader ---------------------------
     * ------------to == address(0) --- ZeroAddress---------------------
     * ------------MigratedOut(to, ------------)
     */
    function migrateOut(address to) external onlyOwner {
        if (to == address(0)) revert ZeroAddress(); // ------------ 0---------------------
        uint256 bal = aip.balanceOf(address(this)); // ------------------------------
        finalePool = 0; // ------------------------------------------------------------
        aip.safeTransfer(to, bal); // ---------------bal=0 --- safeTransfer ---------------------------------------------
        emit MigratedOut(to, bal); // ------------------------------
    }

    // ======================= ------------------------------ depositToPool(poolType=2)--- =======================

    /**
     * depositFinalePool --- ------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------------------ depositToPool(poolType=2) ---------------------------------------------------------------
     *   --------------------------------------------------------------- poolType=2 --- migrate --- revert
     *   PoolMigratedToSub ------------------------------
     * ------------------------------------ external------------------------------------------------ approve ---------
     * ------------amount=------------------ wei ------------------ 1e18 = 1 AIP--------- revert ZeroAmount---
     * ------------amount < 1e18 --- ZeroAmount------------------------------------------------------
     * ------------------AIP------------------ --- ------------------------------------------ approve ---------
     * ---------------finalePool += amount--------------------- (0.002+0.000011--hours) ---------------
     * ------------FinalePoolUpdated(newPoolAmount=---------------, contributor=---------, contribution=amount)
     */
    function depositFinalePool(uint256 amount) external {
        if (paused) revert ContractPaused(); // ------------------------------------------------------------------------------------------
        // --------------------- 1 AIP------------------------------------------------ depositToPool ------------------------
        if (amount < 1e18) revert ZeroAmount();
        // ------------------ AIP ------------------------------------------------ aip.approve(---------, amount)
        // ------ safeTransferFrom ------ transferFrom------------------------ revert---------------------------
        aip.safeTransferFrom(msg.sender, address(this), amount);
        finalePool += amount; // ------------------------
        // ------------------------------newPoolAmount=------------------contributor=------------contribution=---------------
        emit FinalePoolUpdated(finalePool, msg.sender, amount);
    }

    // ======================= ------------------------------------------ =======================

    /**
     * claimFinaleReward --- ---------------------------------------------
     * ----------------------------------------------------------------------------
     * ------------------------------ 12 ---------------------------------
     * ---------------------------------------------------------------------------------------------------------------
     *   - main.getTotalUsdtVolume() >= FINALE_POOL_VOLUME_THRESHOLD---FinalePoolNotActivated---
     *   - main.hasAppAccessById(msg.sender, FINALE_POOL_APP_ID)---RankingAccessDenied---
     *   - lastPoolTrader != address(0)---NoPendingRankingReward------------------
     *   - msg.sender == lastPoolTrader---NotFinaleWinner---
     *   - block.timestamp - lastPoolTradeTime >= FINALE_POOL_COOLDOWN---FinaleCooldownNotElapsed---
     * ------------------reward = finalePool -- (2000 + 11 -- hoursSinceLastClaim) / 1_000_000
     *   - hoursSinceLastClaim = lastFinaleClaimTime == 0 ? 0 : (lastPoolTradeTime + FINALE_POOL_COOLDOWN - lastFinaleClaimTime) / 3600
     *   - ---------------------------------------------------------------------------------------------------------------------
     *   - ---------------------------------------lastFinaleClaimTime==0------ 0 ---------
     *   - ---------------------------------------------------------hours ---------------------------------------------------
     *   - ------ FINALE_POOL_MAX_REWARD---10000 AIP---
     * ---------------finalePool -= reward---lastFinaleClaimTime = now---lastPoolTrader = 0------------------
     * ------------------AIP--------------- --- ------------------------------------------------------------------------
     * ------------FinaleRewardClaimed(msg.sender, reward, hoursSinceLastClaim)
     */
    function claimFinaleReward() external {
        if (IFinalePoolMainView(main).getTotalUsdtVolume() < FINALE_POOL_VOLUME_THRESHOLD) revert FinalePoolNotActivated(); // --------------------- 3,000 USDT------------------------
        if (!IFinalePoolMainView(main).hasAppAccessById(msg.sender, FINALE_POOL_APP_ID)) revert RankingAccessDenied(); // ---------------------------
        if (lastPoolTrader == address(0)) revert NoPendingRankingReward(); // ------------
        if (msg.sender != lastPoolTrader) revert NotFinaleWinner(); // ------------------
        if (block.timestamp - lastPoolTradeTime < FINALE_POOL_COOLDOWN) revert FinaleCooldownNotElapsed(); // 12 ------------

        // ---------------------------------------------------------------------lastPoolTradeTime + 12h------------ block.timestamp
        // ------------------------------------------------------------------------------------------lastFinaleClaimTime==0------ 0 ---------
        uint256 hoursSinceLastClaim = lastFinaleClaimTime == 0
            ? 0
            : (lastPoolTradeTime + FINALE_POOL_COOLDOWN - lastFinaleClaimTime) / 3600;

        // reward = finalePool -- (2000 + 11 -- hours) / 1_000_000
        uint256 reward = finalePool * (2000 + 11 * hoursSinceLastClaim) / 1_000_000;
        if (reward > FINALE_POOL_MAX_REWARD) reward = FINALE_POOL_MAX_REWARD; // ------------ 10000 AIP
        if (reward > finalePool) reward = finalePool; // ------------

        finalePool -= reward; // ------------
        lastFinaleClaimTime = block.timestamp; // ------------------------
        lastPoolTrader = address(0); // ---------------------------------------------------

        aip.safeTransfer(msg.sender, reward); // --- AIP ------------------------------------------------------------
        emit FinaleRewardClaimed(msg.sender, reward, hoursSinceLastClaim);
    }

    // ======================= ------------------------------------------ =======================

    /**
     * getFinalePoolInfo --- ---------------------------------4 ---------------
     * ----------------------------------------------------------------------------
     * ------------------------------------------------------------------------------------------------------------------------------------
     */
    function getFinalePoolInfo() external view returns (
        uint256 _finalePool,
        address _lastPoolTrader,
        uint256 _lastPoolTradeTime,
        uint256 _lastFinaleClaimTime
    ) {
        return (finalePool, lastPoolTrader, lastPoolTradeTime, lastFinaleClaimTime);
    }
}
