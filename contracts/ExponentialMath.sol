/**
 * ============================================================================
 *  ExponentialMath.sol --- --------- 1e18 ---------------/------/------------------
 * ----------------------------------------------------------------------------
 *  ---library ---------
 *  ------------ Solidity ------------------ 4 ------------------------------------ 1e18 ------------
 *    1. pow10(x)     ------ ------ 10^x         ------------------------
 *    2. _exp(x)      ------ ------ e^x          ------------------
 *    3. _ln(x)       ------ ------ ln(x)        ------------------
 *    4. pow(base,exp)------ ------ base^exp     ---------------------------
 *  --- 4 ------------ Solidity ------------------------------------------------------ + ---------------------
 *
 *  --------------- internal library---
 *    - library ------ `internal` ------------------------------------------------------inline------
 *      ------------------------------"------------"---------------------------------
 *    - ------------ ------------------------ Gas---external call --- 2600 Gas------
 *           --- ---------------------------------------
 *           --- ------------------------------------------------------------------
 *    - --------------------------------------------------------------- pow ------------------------ pow ---
 *      ------------ _ln---_exp---pow10 ------------------------
 *
 *  ------ BondingCurve ------------------------------
 *    - BondingCurve --- `_getCurrentPrice` ---------------------------------------
 *          P = 0.1 + 0.9 -- (V -- 3,000,000)^--
 *      ------ V = ------ AIP ----------------- --- [1.22, 1.38] ------------------------------------------
 *    - ------------ (V--3M)^-- ------------------------ `pow(uint256 base, int256 exponent)`
 *      base = V--3M -- 1e18------------------exponent = -- -- 1e18---------------
 *    - ------------------------------------------------------------------------
 *
 *  ------------------
 *    - 1e18 = 1.0------------------------------------------------ 1e18 ------------
 *    - ---------1.5 --------- 1_500_000_000_000_000_000 = 1.5e18
 *           0.001 --------- 1_000_000_000_000_000 = 1e15
 *    - int256 ------------------------------ _exp ------------------_ln ---------------
 *    - --------------------------- 1e18 ------------------------ PRECISION ------
 *
 *  ------------------------
 *    - 10^x = e^(x -- ln(10))                  ------ pow10 ---------------
 *    - e^x = 1 + x + x--/2! + x--/3! + ...      ------ _exp ---------------
 *    - e^x = (e^(x/2^n))^(2^n)                ------ _exp ---------------------
 *    - ln(x) = intPart -- ln(10) + ln(normalized) ------ _ln ---------------
 *    - ln(x) = 2 -- atanh((x-1)/(x+1))        ------ _ln ------------------------
 *    - base^exp = e^(exp -- ln(base))          ------ pow ---------------
 *
 *  ------------------
 *    - ------ // --- /\* *\/ ------------ Solidity --------------------------------- bytecode --- Gas
 *    - --------------- BondingCurve.sol ------------------------ /\* *\/--------- //
 * ============================================================================
 */
pragma solidity ^0.8.24; // Solidity --------------------- ---0.8.24 --- <0.9.0

library ExponentialMath { // ------------------ internal ------------------------------
  // pow10 --------------------------------------------------- 10^------------------------ 1 ---------
  // --- BondingCurve ------------------ pow10 --------- 10^------------------
  error NegativeExponent();

  // _exp --------------------- -42139678854452767551 --- -42.14 -- 1e18------ e^(-42.14) --- 5e-19---
  // ------ e^x ------------------------ 1e18 / 1e18 = 0 ------------------ 0------------------------ revert
  error ExpUnderflow();

  // _exp --------------------- 135305999368893231588 --- 135.31 -- 1e18------ e^135.31 ------ int256 ---------
  // ------ e^x ------------------------ int256 --------- 2^255-1------------------------ revert
  error ExpOverflow();

  // pow ---------------------------------------e^x > 0------------------------------------------ result ---------
  // ---------------------------revert PowNegative ---------------------------------------------------
  error PowNegative();

  // ln(10) -- 1e18 --- 2.302585 -- 1e18 = 2302585092994045684
  // ---------pow10 ------ 10^x --------- e^(x -- ln(10))--------- _ln ------ log10 ------------------ ln
  int256 internal constant LN10 = 2302585092994045684; // ln(10) * 1e18

  // ------------ PRECISION = 1e18--------------------------- 1.0
  // --------------------------------------- PRECISION ------------------------------------ PRECISION ------------
  int256 internal constant PRECISION = 1e18;

  /**
   * @notice ------ 10^exponent--------------------------------- 1e18 ---------
   * @dev    ---------------10^x = e^(x -- ln(10))
   *         ------------ ------ exponent --------------- revert NegativeExponent---
   *               --- ------ x -- ln(10) / 1e18 ------ e ---------------
   *               --- ------ _exp ------ e^(------) ------ 10^x
   * @param  exponent 10 ------------------ --- 0--------- revert NegativeExponent---
   * @return 10^exponent ---------------------1e18 = 1.0---
   */
  function pow10(int256 exponent) internal pure returns (int256) {
    if (exponent == 0) return PRECISION; // ---------10^0 = 1--------------- 1e18
    if (exponent < 0) revert NegativeExponent(); // ------------------------------revert

    // 10^x = e^(x * ln(10))
    // --- 10 --------------------- e --------------------- x -- ln(10) / 1e18--------- 1e18 ---------------
    int256 lnExponent = exponent * LN10 / PRECISION;
    return _exp(lnExponent); // ------ _exp ------ e^(x -- ln(10)) = 10^x
  }

  /**
   * @notice ------ e^x------------------------------
   * @dev    --------------------------- + ------------
   *         ---------------e^x = (e^(x/2^n))^(2^n)
   *         ---------
   *           --- ---------------x=0 ------ 1---x<------ revert ExpUnderflow---x>------ revert ExpOverflow
   *           --- --------------------- negative------ x ------------------------ 1/e^|x| ---------
   *           --- --------------------- while --------- x ------------ 2--------- x < 1e18------ < 1.0---
   *                      ------------------ n--------- e^x = (e^(x/2^n))^(2^n)
   *           --- ---------------e^y = 1 + y + y--/2! + y--/3! + ...--------- 15 ------ term=0 ---------------
   *           --- --------------------------------------- n --------- (e^y)^(2^n) = e^x
   *           --- ------------------ negative--------- 1e36 / sum = 1/e^|x|
   * @param  x ------------------------------------1e18 = 1.0------------ [-42.14, 135.31]---
   * @return e^x ---------------------1e18 = 1.0---
   */
  function _exp(int256 x) internal pure returns (int256) {
    if (x == 0) return PRECISION; // ---------e^0 = 1--------------- 1e18

    // ---------------x < -42139678854452767551------ -42.14e18------ e^x --- 0---------------revert
    if (x < -42139678854452767551) revert ExpUnderflow();
    // ---------------x > 135305999368893231588------ 135.31e18------ e^x ------ int256 ---------------------revert
    if (x > 135305999368893231588) revert ExpOverflow();

    // For negative x, compute e^(-x) and invert
    // ------------------ x < 0--------- negative=true--------- x ------------------------
    // --------------------- e^|x|--------------- 1/e^|x| = e^(-|x|) ------------
    bool negative = x < 0; // ---------------------------
    if (negative) x = -x; // ------------------------------------

    // Reduce input: e^x = (e^(x/2^n))^(2^n)
    // --------------------------- x ------------------ x/2^n---------------------------------
    // ------------------e^x = (e^(x/2^n))^(2^n) = ((...(e^(x/2^n))^2)^2...)^2--------- n ------
    // We reduce x to be < 1 (in 1e18 precision)
    // ------------ x --------- < 1e18------ < 1.0------------------------------------------
    uint8 n = 0; // ------------------------------------------------------
    while (x > PRECISION) { // --- x --------- 1e18------ > 1.0------------------
      x = x / 2; // --- x ------
      n++; // ------------ +1
    }

    // Taylor series: e^x = 1 + x + x^2/2! + x^3/3! + ...
    // ---------------------e^y = 1 + y + y--/2! + y--/3! + y---/4! + ...
    // x is now < 1e18, so terms converge quickly
    // --------------------- x --------- < 1e18------------------------------------ 15 ---------------
    int256 term = PRECISION; // ------------------------ 1------ y---/0! = 1---
    int256 sum = PRECISION; // ------------------------ 1------------ 1---
    for (uint8 i = 1; i <= 15; i++) { // --- i=1 --- 15--------------- 15 ---
      // ---------------term_i = term_{i-1} -- x / (PRECISION -- i)
      // ------------ = --------- -- y / i--------- PRECISION ------------------------------
      // ------ int8(i) ------------ uint8 --------------------------- int256 ------
      term = term * x / (PRECISION * int256(int8(i)));
      sum += term; // ---------------
      if (term == 0) break; // ------------------------------------ 0---------------------------------------
    }

    // Square back n times: e^x = (e^(x/2^n))^(2^n)
    // --------------------------------------------- e^(x/2^n) ------ n ------------ e^x
    // ---------------(e^(x/2^n))^(2^n) = e^(x/2^n -- 2^n) = e^x
    for (uint8 i = 0; i < n; i++) { // ------ n ---------------------------------------------
      sum = sum * sum / PRECISION; // --------------- PRECISION ---------------------
    }

    if (negative) { // --------------- x ---------------------------------
      // e^(-|x|) = 1 / e^|x| = 1e18 / sum---------------------
      // --------- PRECISION * PRECISION / sum ------------------------1e36 / sum = 1e18 -- (1e18 / sum)
      sum = PRECISION * PRECISION / sum; // 1 / e^|x| ------------------------ 1e36 / sum
    }

    return sum; // ------ e^x ------------------
  }

  /**
   * @notice ------ ln(x)------------------------------
   * @dev    ---------------ln(x) = intPart -- ln(10) + ln(normalized)
   *         ---------
   *           --- ---------------x=0 ------ int256.min--------- ----------x=1e18 ------ 0---ln(1)=0---
   *           --- ------------------ intPart--------- while --------- log10 ---------------
   *              -- --- x --- 1e18 ------------------ 10 ------ < 10---intPart --- -18 ------------
   *              -- --- x < 1e18 ------------------ 10 ------ --- 1e18---intPart --- -1 ------------
   *           --- --------------- x --------- [1e18, 10e18) ------------ [1.0, 10.0)---
   *           --- atanh ------------------------------ ln---
   *              ln(x) = 2 -- atanh((x-1)/(x+1))
   *              atanh(z) = z + z--/3 + z---/5 + z---/7 + ...--------- 20 ------
   *           --- ---------------intPart -- LN10 + lnResult
   * @param  x ---------------------------------1e18 = 1.0---x=0 ------ int256.min---
   * @return ln(x) ------------------------------1e18 = 1.0---x<1 ------------------
   */
  function _ln(uint256 x) internal pure returns (int256) {
    if (x == 0) return type(int256).min; // ---------ln(0) = ---------- int256 ---------------
    if (x == 1e18) return 0; // ---------ln(1) = 0--------------- 0

    // Find integer part of log10(x / 1e18) --- same logic as log10
    // ------ log10(x / 1e18) --------------------- x --- 10 ------------------------
    // ------ x = 5e18------ 5.0------log10(5) = 0.698--------------- intPart = 0
    //      x = 50e18------ 50.0------log10(50) = 1.698--------------- intPart = 1
    uint256 xRaw = x; // ------------ x ------------------------------
    int256 intPart; // log10(x/1e18) ---------------
    if (xRaw >= 1e18) { // ------ A---x --- 1.0------ -18 --------------------- xRaw --- 1e18 ---------------------
      uint256 temp = xRaw; // --------------------------- 10 ------ < 10
      intPart = -18; // ------------ -18--------- xRaw = --------- -- 1e18------------ 1e18 --------- 10^18---
      while (temp >= 10) { // --- temp --- 10 --------------- 10
        temp /= 10; // ------ 10 ---
        intPart++; // ------------ +1
      }
    } else { // ------ B---x < 1.0------ 0 < x < 1e18--------- -1 ------------
      intPart = -1; // ------------ -1
      uint256 temp = xRaw * 10; // ------ 10 ---------------
      while (temp < 1e18) { // --- temp --- < 1e18--------------- < 1.0------------------
        temp *= 10; // ------ 10 ---
        intPart--; // ------------ -1
      }
    }

    // Normalize x to [1e18, 10e18) range
    // --------------- x --------- [1e18, 10e18) ------------ [1.0, 10.0)---
    // ------------------------ ln(normalized) --- [0, ln(10)) --- [0, 2.302585)
    // ------------ atanh --------- |z| < 1 ---------------------
    uint256 normalized = xRaw; // --------- x ---------------
    if (normalized >= 10e18) { // ------ A---normalized --- 10.0---------------
      while (normalized >= 10e18) { // ------------ 10 ------ < 10e18
        normalized /= 10; // ------ 10 ---
      }
    } else { // ------ B---normalized < 1.0---------------
      while (normalized < 1e18) { // ------------ 10 ------ --- 1e18
        normalized *= 10; // ------ 10 ---
      }
    }

    // Compute ln(normalized) using atanh series
    // ------ atanh ------------------------------ ln(normalized)
    // ln(x) = 2 * atanh((x-1)/(x+1))
    // ---------------ln(x) = 2 -- atanh((x-1)/(x+1))--------- atanh --- |z|<1 ------------
    // atanh(z) = z + z^3/3 + z^5/5 + ...
    // atanh ---------atanh(z) = z + z--/3 + z---/5 + z---/7 + ...------------------------
    // ------ normalized --- [1e18, 10e18)---z = (normalized-1)/(normalized+1) --- [0, 0.818)
    // |z| < 1---------------
    int256 z = (int256(normalized) - PRECISION) * PRECISION / (int256(normalized) + PRECISION); // ------ z = (x-1)/(x+1)
    int256 zSq = z * z / PRECISION; // --------- z--------------------------------------

    int256 term = z; // ------------------------ z------ z--/1---
    int256 lnResult = z; // ------------------------ z---------------
    for (uint8 i = 1; i <= 20; i++) { // --- i=1 --- 20--------------- 20 ---
      // ---------term_i = term_{i-1} -- z----------------- +2------------------------------
      term = term * zSq / PRECISION; // --------- -- z----------- z^(2i+1)
      int256 divisor = int256(int8(2 * i + 1)); // ------ = 2i+1------------3, 5, 7, ..., 41---
      lnResult += term / divisor; // ---------------
      if (term / divisor == 0) break; // ------------------------------------ 0---------------
    }
    lnResult = lnResult * 2; // ------------ 2--------- ln(x) = 2 -- atanh(z)---

    // ln(x) = intPart -- ln(10) + ln(normalized)
    // ------------ = ------------ -- ln(10) + ------------------------
    // intPart -- LN10 ------------------------------------ 10 ---------
    return intPart * LN10 + lnResult;
  }

  /**
   * @notice ------ base^exponent---------------------------------------
   * @dev    ---------------base^exp = e^(exp -- ln(base))
   *         ---------
   *           --- 3 ------------------------
   *              -- base=0 --- exp>0--------- 0---0 --------------- = 0---
   *              -- base=0 --- exp---0--------- 1e18---0 --- 0 --------------- 1---
   *              -- base=1e18--------- 1e18---1 --------------- = 1---
   *              -- exp=0--------- 1e18--------------- 0 ------ = 1---
   *           --- ------ _ln(base) ------ ln(base)
   *           --- ------ exp -- lnBase / 1e18 ------ e ---------------
   *           --- ------ _exp(x) ------ e^(exp -- ln(base)) = base^exp
   *           --- ------------------------------------ revert PowNegative------------------------
   * @param  base     ------------------------------1e18 = 1.0---
   * @param  exponent ------------------------------1e18 = 1.0------------------------------
   * @return base^exponent ------------------------------1e18 = 1.0---
   */
  function pow(uint256 base, int256 exponent) internal pure returns (uint256) {
    // ------ 1---base=0 ------exp>0 ------ 0---0^------=0------exp---0 ------ 1e18---0^0 --------- 1---
    if (base == 0) return exponent > 0 ? 0 : 1e18;
    // ------ 2---base=1e18------ 1.0---------1 --------------------- 1--------------- 1e18
    if (base == 1e18) return 1e18;
    // ------ 3---exponent=0 ------------------------ 0 ------------ 1--------------- 1e18
    if (exponent == 0) return 1e18;
    int256 lnBase = _ln(base); // ------ ln(base)--------- e ------------------------
    int256 x = exponent * lnBase / PRECISION; // ------ exp -- ln(base) / 1e18--------- 1e18 ---------------
    int256 result = _exp(x); // ------ e^(exp -- ln(base)) = base^exp
    if (result < 0) revert PowNegative(); // ------------------e^x ------------------------------------------revert
    return uint256(result); // --- int256 --------------- uint256 ------------------------------------
  }
}
