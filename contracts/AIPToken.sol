pragma solidity ^0.8.24; // Solidity --------------------- ---0.8.24 --- <0.9.0------------------------------------

import "@openzeppelin/contracts/token/ERC20/ERC20.sol"; // ------ OpenZeppelin ------ ERC20 ------------------------------

/**
 * @title AIPToken --- AIP ------------
 * @notice ------------------------ 20,000,000 AIP --- BondingCurve---------------------------
 * @dev ------ ERC20------------------------------------------------------------------------
 */
contract AIPToken is ERC20 { // ------ OpenZeppelin ERC20--------------- transfer/balanceOf/allowance ---------------
    /**
     * @notice ------------------------------ 20,000,000 AIP --- BondingCurve ------
     * @param  bondingCurve BondingCurve --------------------------- 2000 --- AIP------------------------
     */
    constructor(address bondingCurve) ERC20("AIP", "AIP") { // ------------ name="AIP"--------- symbol="AIP"------------AI ---------------
        // --------------- 20,000,000 AIP---2000 --------- BondingCurve ------------
        // ------ = 20_000_000 * 10 ** decimals() = 20_000_000 * 1e18 = 2e25 ------------
        // ------------ AIP --- BondingCurve ------------------/---------/------/---------------------------------
        _mint(bondingCurve, 20_000_000 * 10 ** decimals());
    }
}
